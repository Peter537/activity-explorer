<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ActivityExplorer.Core/ActivityExplorer.Core.csproj" />
    <ProjectReference Include="../../src/ActivityExplorer.Infrastructure/ActivityExplorer.Infrastructure.csproj" />
    <ProjectReference Include="../../src/ActivityExplorer.Mcp/ActivityExplorer.Mcp.csproj" />
    <ProjectReference Include="../../src/ActivityExplorer.Web/ActivityExplorer.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>McpTargetPath</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)/../../src/ActivityExplorer.Mcp/bin/$(Configuration)/$(TargetFramework)/ActivityExplorer.Mcp.dll</_Parameter2>
    </AssemblyAttribute>
    <None Update="testconfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
