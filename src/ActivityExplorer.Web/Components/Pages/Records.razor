@page "/records"
@implements IDisposable
@inject IStatisticsService Statistics
@inject IActivityQueryService Activities
@inject ProfileState ProfileState
@inject NavigationManager Navigation
@using ActivityExplorer.Web.Components.Shared

<PageTitle>Records - Activity Explorer</PageTitle>
<PageHeader Title="Records" Summary="Compare your best results and open the activity behind each one.">
    <Actions>
        <label class="scope-control" for="record-scope">
            <span>Record scope</span>
            <select id="record-scope" value="@ScopeValue" @onchange="ChangeScope" aria-describedby="record-scope-help">
                <option value="all">All training (including indoor)</option>
                <option value="indoor">Indoor only</option>
                <option value="outdoor">Outdoor only</option>
            </select>
            <small id="record-scope-help">Indoor only includes indoor, virtual, and GPS-less activities without an outdoor classification. Outdoor only excludes them.</small>
        </label>
    </Actions>
</PageHeader>
@if (_sports.Length > 0)
{
    <nav class="sport-selector" aria-labelledby="record-sport-label">
        <span id="record-sport-label">Sport</span>
        <div class="sport-options">
            @foreach (var sport in _sports)
            {
                <a @key="sport" href="@RecordsUrl(sport, _scope)" aria-current="@(sport == _selectedSport ? "true" : null)">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        @switch (sport)
                        {
                            case SportKind.Cycling:
                                <circle cx="5" cy="17" r="4" /><circle cx="19" cy="17" r="4" />
                                <path d="m5 17 5-9 5 9H5m5-9h7l2 9M8 5h4m4-1h3l1 3" />
                                break;
                            case SportKind.Running:
                                <circle cx="15" cy="4" r="2" />
                                <path d="m8 9 4-2 4 5 4 1M12 7l-2 7 5 3-2 5M10 14l-4 5H2" />
                                break;
                            case SportKind.Walking:
                                <circle cx="13" cy="4" r="2" />
                                <path d="m7 12 3-4 4 1 2 4 4 1M11 8l-1 7-4 7m4-7 4 1 2 6" />
                                break;
                            case SportKind.Rowing:
                                <circle cx="13" cy="5" r="2" />
                                <path d="m12 8-3 5 5 2 2 3M10 11l7 1M4 9l15 12M2 17h20l-3 4H6l-4-4" />
                                break;
                        }
                    </svg>
                    <span>@sport</span>
                </a>
            }
        </div>
    </nav>
}
<details class="notice subtle methodology">
    <summary>How records qualify</summary>
    <p>Only achieved benchmarks are shown. Rowing distance bests can use valid per-point recorded distance without GPS; other sports require valid GPS. Distance and timed distance bests use elapsed time, so pauses and recording gaps count. Indoor activities can qualify for timed distance bests from valid per-point recorded distance. Power bests require at least 98% coverage with no sample gap over 5 seconds.</p>
</details>
@if (_records is null && _loadError is null)
{
    <div class="loading" role="status">Loading @ScopeLabel.ToLowerInvariant() records...</div>
}
else if (_loadError is not null)
{
    <div class="notice error records-error" role="alert">
        <div><strong>Records could not be loaded.</strong><span>@_loadError</span></div>
        <button class="button" @onclick="Load">Try again</button>
    </div>
}
else if (_sports.Length == 0)
{
    <section class="empty-state">
        <h2>No records calculated</h2>
        <p>Import activities to calculate records.</p>
    </section>
}
else if (!_records!.Any(record => record.Sport == _selectedSport))
{
    <section class="empty-state">
        <h2>No @_selectedSport records for @ScopeLabel.ToLowerInvariant()</h2>
        <p>No achieved records match this sport and scope.</p>
        <a class="button" href="@RecordsUrl(_selectedSport, RecordScope.All)">View all training</a>
    </section>
}
else
{
    @foreach (var sportGroup in _records!.Where(record => record.Sport == _selectedSport).GroupBy(record => record.Sport))
    {
        var activityRecords = sportGroup.Where(record => IsActivityRecord(record.Kind)).ToArray();
        var distanceRecords = sportGroup.Where(record => record.Kind == RecordKind.DistanceEffort).ToArray();
        var timedDistanceRecords = sportGroup.Where(record => record.Kind == RecordKind.TimedDistanceEffort).ToArray();
        var powerRecords = sportGroup.Where(record => record.Kind == RecordKind.PowerCurve).ToArray();
        <section class="panel records-panel">
            <div class="panel-heading"><h2>@sportGroup.Key</h2><span>@ScopeLabel</span></div>
            @if (activityRecords.Length > 0)
            {
                <div class="records-section">
                    <h3>Activity records</h3>
                    @RecordTable(activityRecords, $"{sportGroup.Key} activity records")
                </div>
            }
            @if (distanceRecords.Length > 0)
            {
                <div class="records-section">
                    <h3>Distance bests</h3>
                    @RecordTable(distanceRecords, $"{sportGroup.Key} distance bests")
                </div>
            }
            @if (timedDistanceRecords.Length > 0)
            {
                <div class="records-section">
                    <h3>Timed distance bests</h3>
                    @RecordTable(timedDistanceRecords, $"{sportGroup.Key} timed distance bests")
                </div>
            }
            @if (powerRecords.Length > 0)
            {
                <div class="records-section">
                    <h3>Power bests</h3>
                    @RecordTable(powerRecords, $"{sportGroup.Key} power bests")
                </div>
            }
        </section>
    }
}

@code {
    private IReadOnlyList<PersonalRecord>? _records;
    private readonly Dictionary<RecordScope, IReadOnlyList<PersonalRecord>> _scopeRecords = [];
    private IReadOnlyDictionary<SportKind, int> _activityCounts = new Dictionary<SportKind, int>();
    private SportKind[] _sports = [];
    private SportKind? _selectedSport;
    private RecordScope _scope = RecordScope.All;
    private Guid? _loadedOwner;
    private int _loadVersion;
    private string? _loadError;

    [Parameter, SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "sport")]
    public string? QuerySport { get; set; }

    private string ScopeValue => _scope switch { RecordScope.Outdoor => "outdoor", RecordScope.Indoor => "indoor", _ => "all" };
    private string ScopeLabel => _scope switch { RecordScope.Outdoor => "Outdoor only", RecordScope.Indoor => "Indoor only", _ => "All training" };

    protected override void OnInitialized() => ProfileState.Changed += Changed;

    protected override async Task OnParametersSetAsync()
    {
        _scope = QueryScope?.ToLowerInvariant() switch
        {
            "outdoor" => RecordScope.Outdoor,
            "indoor" => RecordScope.Indoor,
            _ => RecordScope.All
        };
        await RefreshRecords();
    }

    private async Task RefreshRecords()
    {
        var version = ++_loadVersion;
        var owner = ProfileState.SelectedOwnerId;
        var scope = _scope;
        _records = null;
        _loadError = null;
        if (_loadedOwner != owner)
        {
            _scopeRecords.Clear();
            _sports = [];
        }
        try
        {
            if (!_scopeRecords.TryGetValue(RecordScope.All, out var allRecords))
            {
                var recordsTask = Statistics.GetRecordsAsync(owner, RecordScope.All);
                var countsTask = Activities.GetSportActivityCountsAsync(owner);
                await Task.WhenAll(recordsTask, countsTask);
                if (version != _loadVersion) return;
                allRecords = await recordsTask;
                _activityCounts = await countsTask;
                _scopeRecords[RecordScope.All] = allRecords;
                _loadedOwner = owner;
                _sports = allRecords.Select(record => record.Sport).Distinct().Order().ToArray();
            }

            if (!_scopeRecords.TryGetValue(scope, out var records))
            {
                records = await Statistics.GetRecordsAsync(owner, scope);
                if (version != _loadVersion) return;
                _scopeRecords[scope] = records;
            }
            _records = records;
            var requested = ParseSport(QuerySport);
            var available = requested.HasValue && _sports.Contains(requested.Value);
            _selectedSport = available ? requested : _sports
                .OrderByDescending(sport => _activityCounts.GetValueOrDefault(sport))
                .Select(sport => (SportKind?)sport).FirstOrDefault();

            var canonicalScope = scope == RecordScope.All ? null : ScopeValue;
            var canonicalSport = available ? requested!.Value.ToString().ToLowerInvariant() : null;
            if (QueryScope != canonicalScope || QuerySport != canonicalSport)
                Navigation.NavigateTo(RecordsUrl(available ? requested : null, scope), replace: true);
        }
        catch (Exception exception)
        {
            if (version == _loadVersion) _loadError = exception.Message;
        }
    }

    private static SportKind? ParseSport(string? value) => value?.ToLowerInvariant() switch
    {
        "cycling" => SportKind.Cycling,
        "running" => SportKind.Running,
        "walking" => SportKind.Walking,
        "rowing" => SportKind.Rowing,
        _ => null
    };

    private static string RecordsUrl(SportKind? sport, RecordScope scope)
    {
        var parameters = new List<string>();
        if (sport.HasValue) parameters.Add($"sport={sport.Value.ToString().ToLowerInvariant()}");
        if (scope != RecordScope.All) parameters.Add($"scope={scope.ToString().ToLowerInvariant()}");
        return parameters.Count == 0 ? "/records" : $"/records?{string.Join("&", parameters)}";
    }

    private void ChangeScope(ChangeEventArgs args)
    {
        var scope = args.Value?.ToString() switch
        {
            "outdoor" => RecordScope.Outdoor,
            "indoor" => RecordScope.Indoor,
            _ => RecordScope.All
        };
        Navigation.NavigateTo(RecordsUrl(ParseSport(QuerySport), scope));
    }

    private async Task Load()
    {
        _scopeRecords.Clear();
        _sports = [];
        await RefreshRecords();
    }

    private void Changed() => InvokeAsync(async () => { await Load(); StateHasChanged(); });

    private static bool IsActivityRecord(RecordKind kind) =>
        kind is RecordKind.Distance or RecordKind.Duration or RecordKind.Elevation or RecordKind.AverageSpeed;

    private static string Value(PersonalRecord record) => record.Kind switch
    {
        RecordKind.Distance or RecordKind.TimedDistanceEffort => Format.Distance(record.Value),
        RecordKind.Duration or RecordKind.DistanceEffort => Format.Duration(record.Value),
        RecordKind.Elevation => $"{record.Value:N0} m",
        RecordKind.AverageSpeed => record.Sport == SportKind.Rowing ? Format.Speed(record.Value, record.Sport) : $"{record.Value * 3.6:N1} km/h",
        RecordKind.PowerCurve => $"{record.Value:N0} W",
        _ => $"{record.Value:N1}"
    };

    private static RenderFragment RecordTable(IReadOnlyList<PersonalRecord> records, string caption) => @<div class="records-table-wrap">
        <table class="records-table">
            <caption class="visually-hidden">@caption</caption>
            <colgroup><col class="benchmark-column" /><col class="result-column" /><col class="profile-column" /><col class="date-column" /><col class="coverage-column" /></colgroup>
            <thead><tr><th scope="col">Benchmark</th><th scope="col">Result</th><th scope="col">Profile</th><th scope="col">Date</th><th scope="col">Coverage</th></tr></thead>
            <tbody>
            @foreach (var record in records)
            {
                <tr>
                    <th scope="row" data-label="Benchmark">
                        <a href="@($"/activities/{record.ActivityId}")" aria-label="@($"{record.Key}: {Value(record)}, from {record.ActivityTitle}")">
                            <strong>@record.Key</strong><small>@record.ActivityTitle</small>
                        </a>
                    </th>
                    <td data-label="Result"><strong>@Value(record)</strong></td>
                    <td data-label="Profile">@record.OwnerName</td>
                    <td data-label="Date">@record.ActivityDate.ToLocalTime().ToString("d")</td>
                    <td data-label="Coverage">@record.CoveragePercent.ToString("N0")%</td>
                </tr>
            }
            </tbody>
        </table>
    </div>;

    public void Dispose()
    {
        ++_loadVersion;
        ProfileState.Changed -= Changed;
    }
}
