@page "/routes"
@implements IDisposable
@inject IRouteService RouteService
@inject ProfileState ProfileState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using ActivityExplorer.Web.Components.Shared

<PageTitle>Routes - Activity Explorer</PageTitle>
<PageHeader Title="Routes" Summary="Save activity tracks, draw a path, import GPX, and export standard GPX files." />
@if (_message is not null) { <div class="notice" role="alert">@_message</div> }
@if (ProfileState.Profiles.Count > 0)
{
    <section class="dashboard-grid">
    <section class="panel form-panel shared-path-fields">
        <h2>Route details</h2>
        <div class="form-grid">
            <label><span>Profile</span><select @bind="_ownerId">@foreach (var profile in ProfileState.Profiles) { <option value="@profile.Id">@profile.DisplayName</option> }</select></label>
            <label><span>Sport</span><select @bind="_sport">@foreach (var sport in Format.Sports) { <option value="@sport">@sport</option> }</select></label>
            <label class="wide"><span>Name</span><input @bind="_name" /></label>
        </div>
    </section>
        <article class="panel form-panel">
            <div class="panel-heading"><h2>Draw a route</h2><span>@_drawn.Count points</span></div>
            <MapCanvas @ref="_drawMap" Editable="true" PointsChanged="DrawingChanged" CssClass="detail-map" Label="Route drawing map" ShowDisclosure="true" />
            <div class="button-row"><button class="button" @onclick="Undo">Undo point</button><button class="button" @onclick="Clear">Clear</button><button class="button primary" disabled="@(!CanSave || _busyAction)" @onclick="CreateDrawn">@(_busyAction ? "Saving route..." : "Save route")</button></div>
        </article>
        <article class="panel form-panel">
            <h2>Import a GPX path</h2>
            <p class="muted">Track and route points are read with a hardened XML parser. No account or routing service is contacted.</p>
            <label class="file-drop" for="route-import-file"><span>Choose a GPX route file</span><input id="route-import-file" type="file" accept=".gpx,application/gpx+xml" /></label>
            <button class="button" disabled="@(!CanName || _busyAction)" @onclick="ImportGpx">@(_busyAction ? "Importing GPX..." : "Import GPX")</button>
        </article>
    </section>
}
else
{
    <section class="empty-state"><h2>Create a profile first</h2><p>Routes belong to a local profile. Create one before drawing or importing a path.</p><a class="button primary" href="/profiles">Create profile</a></section>
}
<section aria-label="Saved routes">
<h2>Saved routes</h2>
@if (QueryImportBatch is not null || QueryImportOwner is not null)
{
    <div class="notice" aria-label="Linked import filter"><p>Showing currently retained route associations from this import.</p>
        @if (_importScope is { } importScope && importScope.OwnerId != ProfileState.SelectedOwnerId && ProfileState.Profiles.FirstOrDefault(profile => profile.Id == importScope.OwnerId) is { } importOwner)
        { <button class="button" @onclick="() => ProfileState.Select(importOwner.Id)">Switch to @importOwner.DisplayName</button> }
        <a class="button" href="@ImportLinkScope.Remove(Navigation.Uri)">Remove import filter</a><a class="button" href="/imports">Import history</a>
    </div>
}
<form class="filter-bar" aria-label="Route filters" @onsubmit="ApplyRouteFilters" @onsubmit:preventDefault>
    <label><span>Route name</span><input @bind="_filterSearch" @bind:event="oninput" @bind:after="RouteFiltersChanged" placeholder="Find a saved route" /></label>
    <label><span>Route sport</span><select @bind="_filterSport" @bind:after="RouteFiltersChanged"><option value="">All sports</option>@foreach (var sport in Format.Sports) { <option value="@sport">@sport</option> }</select></label>
    <label><span>Route order</span><select @bind="_filterSort" @bind:after="RouteFiltersChanged"><option value="name-asc">Name A–Z</option><option value="name-desc">Name Z–A</option><option value="distance-asc">Shortest</option><option value="distance-desc">Longest</option><option value="elevation-asc">Least ascent</option><option value="elevation-desc">Most ascent</option></select></label>
    <button class="button primary" type="submit" disabled="@_busyAction">Apply route filters</button>
    <button class="button" type="button" @onclick="ResetRouteFilters" disabled="@_busyAction">Reset route filters</button>
</form>
<StatusMessage Message="@_filterError" IsError="true" />
@if (_routeLoading) { <div class="loading" role="status">Loading routes...</div> }
@if (_routeFailed) { <button class="button" @onclick="Load">Retry loading routes</button> }
@if (_filterDirty && _routes is not null) { <p class="notice" role="status">Apply route filters to update these results.</p> }
@if (_routes is not null) { <p class="muted" role="status">@_routes.Count.ToString("N0") matching @(_routes.Count == 1 ? "route" : "routes")</p> }
@if (_routes?.Count == 0 && HasRouteFilters) { <section class="empty-state"><h3>No matching routes</h3><p>Adjust the route name or sport, or reset the filters.</p><button class="button" @onclick="ResetRouteFilters">Show all routes</button></section> }
else if (_routes?.Count == 0) { <section class="empty-state"><h3>No routes saved</h3><p>Draw a route above, import GPX, or save a GPS activity as a route.</p><a class="button" href="/activities">Browse activities</a></section> }
else if (_routes is not null)
{
    <section class="card-grid">
    @foreach (var route in _routes)
    {
        <a class="entity-card" href="@($"/routes/{route.Id}")"><span class="eyebrow">@route.Sport - @route.OwnerName</span><h2>@route.Name</h2><div class="entity-metrics"><span><strong>@Format.Distance(route.DistanceMeters)</strong><small>distance</small></span><span><strong>@($"{route.ElevationMeters:N0} m")</strong><small>elevation</small></span></div></a>
    }
    </section>
}
</section>
@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "sport")] public string? QuerySport { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "importBatch")] public string? QueryImportBatch { get; set; }
    [SupplyParameterFromQuery(Name = "importOwner")] public string? QueryImportOwner { get; set; }
    private ImportLinkScope? _importScope;
    private IReadOnlyList<RouteSummary>? _routes;
    private IReadOnlyList<TrackPoint> _drawn = [];
    private MapCanvas? _drawMap;
    private Guid _ownerId;
    private string _sport = nameof(SportKind.Cycling);
    private string _name = "New route";
    private string? _message;
    private bool _busyAction;
    private string _filterSearch = "", _filterSport = "", _filterSort = "name-asc";
    private string? _filterError;
    private bool _routeLoading, _routeFailed, _filterDirty, _disposed;
    private int _loadRevision;
    private CancellationTokenSource? _loadCancellation;
    private bool HasRouteFilters => QueryImportBatch is not null || QueryImportOwner is not null || !string.IsNullOrWhiteSpace(_filterSearch) || _filterSport.Length > 0;
    private bool CanName => _ownerId != Guid.Empty && !string.IsNullOrWhiteSpace(_name);
    private bool CanSave => CanName && _drawn.Count >= 2;

    protected override async Task OnInitializedAsync()
    {



        ProfileState.Changed += Changed;
        await ProfileState.InitializeAsync();
        SetOwner();
    }

    protected override async Task OnParametersSetAsync()
    {
        _filterSearch = QuerySearch?.Trim() ?? "";
        _filterSport = Enum.TryParse<SportKind>(QuerySport, true, out var sport) && Enum.IsDefined(sport)
            ? sport.ToString() : QuerySport ?? "";
        _filterSort = QuerySort ?? "name-asc";
        _filterDirty = false;
        await Load();
    }

    private void SetOwner() => _ownerId = ProfileState.SelectedOwnerId ?? ProfileState.Profiles.FirstOrDefault()?.Id ?? Guid.Empty;
    private RouteFilter CurrentRouteFilter()
    {
        _importScope = ImportLinkScope.Parse(QueryImportBatch, QueryImportOwner);
        _importScope?.ValidateOwner(ProfileState.SelectedOwnerId);
        SportKind? sport = null;
        if (_filterSport.Length > 0)
        {
            if (!Enum.TryParse<SportKind>(_filterSport, true, out var parsed) || !Enum.IsDefined(parsed))
                throw new ArgumentException("Choose a valid route sport.");
            sport = parsed;
        }
        if (_filterSort is not ("name-asc" or "name-desc" or "distance-asc" or "distance-desc" or "elevation-asc" or "elevation-desc"))
            throw new ArgumentException("Choose a valid route order.");
        return new(ProfileState.SelectedOwnerId, _filterSearch.Trim(), sport, _filterSort, ImportBatchId: _importScope?.BatchId);
    }

    private async Task Load()
    {
        _loadCancellation?.Cancel();
        var revision = ++_loadRevision;
        using var cancellation = new CancellationTokenSource();
        _loadCancellation = cancellation;
        _routeLoading = true;
        _routeFailed = false;
        _filterError = null;
        try
        {
            var routes = await RouteService.SearchAsync(CurrentRouteFilter(), cancellation.Token);
            if (_disposed || revision != _loadRevision) return;
            _routes = routes;
            _filterDirty = false;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (_disposed || revision != _loadRevision) return;
            _routes = null;
            _routeFailed = exception is not (ArgumentException or InvalidOperationException);
            _filterError = exception is ArgumentException or InvalidOperationException ? exception.Message : "Routes could not be loaded. Try again.";
        }
        finally
        {
            if (revision == _loadRevision) { _routeLoading = false; _loadCancellation = null; }
        }
    }

    private void RouteFiltersChanged()
    {
        _loadRevision++;
        _loadCancellation?.Cancel();
        _loadCancellation = null;
        _routeLoading = false;
        _routeFailed = false;
        _filterDirty = true;
        _filterError = null;
    }

    private async Task ApplyRouteFilters()
    {
        try
        {
            var filter = CurrentRouteFilter();
            var values = new List<string>();
            void Add(string key, string? value) { if (!string.IsNullOrWhiteSpace(value)) values.Add($"{key}={Uri.EscapeDataString(value)}"); }
            Add("q", filter.Search);
            Add("sport", filter.Sport?.ToString().ToLowerInvariant());
            Add("sort", filter.Sort == "name-asc" ? null : filter.Sort);
            Add("importBatch", QueryImportBatch);
            Add("importOwner", QueryImportOwner);
            var target = values.Count == 0 ? "/routes" : $"/routes?{string.Join('&', values)}";
            if (Navigation.ToBaseRelativePath(Navigation.Uri) == target.TrimStart('/')) await Load();
            else Navigation.NavigateTo(target);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException) { _filterError = exception.Message; }
    }

    private Task ResetRouteFilters()
    {
        QueryImportBatch = QueryImportOwner = null;
        _importScope = null;
        _filterSearch = _filterSport = "";
        _filterSort = "name-asc";
        return ApplyRouteFilters();
    }
    private Task DrawingChanged(IReadOnlyList<TrackPoint> points) { _drawn = points; return Task.CompletedTask; }
    private async Task Undo() { if (_drawMap is not null) await _drawMap.UndoAsync(); }
    private async Task Clear() { if (_drawMap is not null) await _drawMap.ClearAsync(); }

    private async Task CreateDrawn()
    {
        _busyAction = true;
        try
        {
            var sport = Enum.Parse<SportKind>(_sport);
            var id = await RouteService.CreateAsync(new CreateRoutePathRequest(_ownerId, _name, "Drawn locally", sport, _drawn));
            Navigation.NavigateTo($"/routes/{id}");
        }

        catch (Exception exception) { _message = exception.Message; }
        finally { _busyAction = false; }
    }

    private async Task ImportGpx()
    {
        _busyAction = true;
        try
        {
            var id = await JS.InvokeAsync<Guid>("activityExplorerImports.uploadRoute", "route-import-file", _ownerId, _sport, _name);
            Navigation.NavigateTo($"/routes/{id}");
        }
        catch (JSException exception) { _message = exception.Message; }
        finally { _busyAction = false; }
    }

    private void Changed() => InvokeAsync(async () => { SetOwner(); await Load(); StateHasChanged(); });

    public void Dispose()
    {
        _disposed = true;
        _loadRevision++;
        _loadCancellation?.Cancel();
        ProfileState.Changed -= Changed;
    }
}
