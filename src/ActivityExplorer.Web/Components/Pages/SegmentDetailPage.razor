@page "/segments/{Id:guid}"
@implements IDisposable
@inject ISegmentService SegmentService
@inject NavigationManager Navigation

<PageTitle>@(_segment?.Summary.Name ?? (_loadError is not null ? "Segment unavailable" : _loaded ? "Segment not found" : "Segment")) - Activity Explorer</PageTitle>
@if (!_loaded && _segment is null)
{
    <div class="loading" role="status">Loading segment...</div>
}
else if (_loadError is not null)
{
    <section class="empty-state"><h1>Segment unavailable</h1><p>@_loadError</p><button class="button" type="button" @onclick="LoadAsync">Try again</button></section>
}
else if (_segment is null)
{
    <section class="empty-state"><h1>Segment not found</h1><p>This segment may have been deleted or the link is no longer valid.</p><a class="button" href="/segments">Back to segments</a></section>
}
else
{
    <PageHeader Title="@_segment.Summary.Name" Summary="@($"Directional: start to finish - {_segment.Summary.ToleranceMeters:N0} m matching tolerance")">
        <Metadata><span>@_segment.Summary.Sport</span><span>@_segment.Summary.OwnerName</span><span>@SourceLabel</span></Metadata>
        <Actions><a class="button primary" href="@($"/segments/{Id}/subsegments/new")">Add sub-segment</a><button class="button" disabled="@_recomputing" @onclick="Recompute">@(_recomputing ? "Recomputing efforts..." : "Recompute efforts")</button></Actions>
    </PageHeader>
    @if (_segment.Parents.Count > 0)
    {
        <nav class="segment-parents" aria-label="Parent segments"><span>Part of</span>
            @foreach (var parent in _segment.Parents)
            {
                <a href="@($"/segments/{parent.Id}")">@parent.Name</a>
            }
        </nav>
    }
    @if (_segment.Summary.SourceKind == SegmentSourceKind.ImportedFile)
    {
        <div class="notice subtle">Imported provenance: @(_segment.Summary.SourceName ?? "user-supplied file")@if (!string.IsNullOrWhiteSpace(_segment.Summary.SourceFormat)) { <text> · @_segment.Summary.SourceFormat</text> }. Only local path geometry and this provenance label were retained.</div>
    }

    @if (HasLegacyEfforts)
    {
        <StatusMessage IsWarning="true" Message="Some efforts use the legacy sample-average calculation. Select Recompute efforts to update this segment to fixed-distance speed and timestamp-weighted sensor averages." />
    }
    <StatusMessage Message="@_recomputeStatus" IsError="@_recomputeFailed" />

    <section class="metric-grid five">
        <MetricCard Label="Distance" Value="@Format.Distance(_segment.Summary.DistanceMeters)" />
        <MetricCard Label="Ascent" Value="@Value(_segment.Summary.ElevationGain, "m")" />
        <MetricCard Label="Descent" Value="@Value(_segment.Summary.ElevationLoss, "m")" />
        <MetricCard Label="Average grade" Value="@Value(_segment.Summary.AverageGrade, "%", 1)" />
        <MetricCard Label="Personal best" Value="@(_segment.Summary.BestElapsedSeconds.HasValue ? Format.Duration(_segment.Summary.BestElapsedSeconds.Value) : "--")" />
    </section>

    <section class="panel comparison-controls" aria-label="Effort view" aria-busy="@(!_loaded ? "true" : "false")">
        <div class="button-row">
            <button type="button" class="@(!IsComparing ? "button primary" : "button")" aria-pressed="@(!IsComparing ? "true" : "false")" @onclick="InspectEffort">Inspect effort</button>
            <button type="button" class="@(IsComparing ? "button primary" : "button")" aria-pressed="@(IsComparing ? "true" : "false")" @onclick="EnterComparison">Compare two efforts</button>
        </div>
        @if (IsComparing)
        {
            <div class="comparison-selectors">
                <div class="comparison-selector"><label for="comparison-baseline">Baseline</label><select id="comparison-baseline" value="@EffortSelectionValue(BaselineId)" @onchange="ChangeBaseline">
                    <option value="">Choose baseline effort</option>
                    @if (HasUnknownSelection(BaselineId)) { <option value="@EffortSelectionValue(BaselineId)">Unavailable selection</option> }
                    @foreach (var effort in _segment.Efforts)
                    {
                        <option value="@effort.Id" disabled="@(effort.Id.ToString() == EffortSelectionValue(ComparisonId))">@EffortLabel(effort)</option>
                    }
                </select></div>
                <div class="comparison-selector"><label for="comparison-effort">Comparison</label><select id="comparison-effort" value="@EffortSelectionValue(ComparisonId)" @onchange="ChangeComparison">
                    <option value="">Choose another effort</option>
                    @if (HasUnknownSelection(ComparisonId)) { <option value="@EffortSelectionValue(ComparisonId)">Unavailable selection</option> }
                    @foreach (var effort in _segment.Efforts)
                    {
                        <option value="@effort.Id" disabled="@(effort.Id.ToString() == EffortSelectionValue(BaselineId))">@EffortLabel(effort)</option>
                    }
                </select></div>
                <button type="button" class="button" disabled="@(!CanSwap)" @onclick="SwapEfforts">Swap efforts</button>
            </div>
            <p class="muted comparison-help">Comparison time − baseline time. Positive means slower; elapsed time includes pauses.</p>
            @if (string.IsNullOrEmpty(BaselineId) || string.IsNullOrEmpty(ComparisonId))
            {
                <p role="status">@(_segment.Efforts.Count < 2 ? "Two distinct efforts are needed to compare this segment." : "Choose another effort to complete the comparison.")</p>
            }
        }
        @if (!_loaded) { <p role="status">Loading @(IsComparing ? "comparison" : "effort")...</p> }
        @if (_comparisonLoadError is not null && IsComparing)
        {
            <div role="alert"><p>@_comparisonLoadError</p><button type="button" class="button" @onclick="LoadAsync">Retry comparison</button></div>
        }
    </section>

    <section id="@_definitionExplorerId" class="segment-definition-explorer">
        <SegmentDefinitionProfile Points="_segment.Points" InspectionGroupId="@_definitionExplorerId" />
        <SegmentSectionStrip Sections="_mapSections" DistanceMeters="_segment.Summary.DistanceMeters" SelectedId="_selectedSectionId" SelectedIdChanged="SelectSection" />
        <section class="panel flush map-panel">
            <MapCanvas @key="(Id, IsComparing ? (Guid?)null : _segment.SelectedEffortId)" InlinePoints="_segment.Points"
                       HighlightPoints="@(IsComparing ? null : _segment.SelectedEffortPoints)" InspectionGroupId="@_definitionExplorerId"
                       BaselineComparisonTrack="@(IsComparing ? _comparisonResult?.BaselineAlignment?.Map : null)"
                       ComparisonTrack="@(IsComparing ? _comparisonResult?.ComparisonAlignment?.Map : null)"
                       Sections="_mapSections" SelectedSectionId="_selectedSectionId" SelectedSectionIdChanged="SelectSection"
                       CssClass="detail-map" Label="@(IsComparing ? "Segment, baseline, and comparison effort map" : "Segment and selected effort map")" />
        </section>
        @if (IsComparing && _comparisonResult is not null && _loaded)
        {
            <SegmentComparisonView Result="_comparisonResult" InspectionGroupId="@_definitionExplorerId" />
        }
    </section>

    @if (!IsComparing)
    {
    <section class="panel subsegment-breakdown" aria-labelledby="subsegments-heading">
        <div class="panel-heading"><div><h2 id="subsegments-heading">Sub-segments</h2><p class="muted">Each section keeps its own history. Results below belong only to the selected parent effort.</p></div></div>
        <StatusMessage Message="@_relationshipStatus" IsError="@_relationshipFailed" />
        @if (_segment.Children.Count == 0)
        {
            <p>No sub-segments yet. <a href="@($"/segments/{Id}/subsegments/new")">Add a section from this path or attach an existing segment.</a></p>
        }
        else
        {
            <p class="muted">@(_segment.SelectedEffortId.HasValue ? $"Selected effort: {_segment.Efforts.First(effort => effort.Id == _segment.SelectedEffortId).StartTime.ToLocalTime():g}" : "No parent effort is available yet.")</p>
            <table class="subsegment-table">
                <thead><tr><th scope="col">Section</th><th scope="col">Distance / grade</th><th scope="col">Personal best</th><th scope="col">Selected effort</th></tr></thead>
                <tbody>
                    @foreach (var child in _segment.Children)
                    {
                        <tr class="@(child.Summary.Id == _selectedSectionId ? "active" : null)" data-subsegment-id="@child.Summary.Id">
                            <th scope="row">
                                <a href="@($"/segments/{child.Summary.Id}")">@child.Summary.Name</a>
                                <div class="subsegment-actions"><button class="text-button" type="button" aria-pressed="@(child.Summary.Id == _selectedSectionId ? "true" : "false")" @onclick="() => SelectSection(child.Summary.Id)">Show on path</button>
                                    <button class="text-button" type="button" disabled="@_removing" @onclick="() => RemoveSection(child.Summary.Id)">Remove from this segment<span class="visually-hidden">: @child.Summary.Name</span></button></div>
                            </th>
                            <td data-label="Distance / grade">@Format.Distance(child.Summary.DistanceMeters)<small>@Value(child.Summary.AverageGrade, "%", 1)</small></td>
                            <td data-label="Personal best">@(child.Summary.BestElapsedSeconds.HasValue ? Format.Duration(child.Summary.BestElapsedSeconds.Value) : "--")</td>
                            <td data-label="Selected effort">
                                @if (child.Efforts.Count == 0)
                                {
                                    <span class="muted">No matching pass in this effort</span>
                                }
                                else
                                {
                                    <ol class="subsegment-passes">
                                        @for (var pass = 0; pass < child.Efforts.Count; pass++)
                                        {
                                            var effort = child.Efforts[pass];
                                            <li><a href="@($"/segments/{child.Summary.Id}?effort={effort.Id}")">Pass @(pass + 1) · @Format.Duration(effort.ElapsedSeconds)</a><small>@Format.Speed(effort.AverageSpeed, child.Summary.Sport)</small>
                                                @if (!effort.MetricsCurrent) { <small>Legacy calculation</small> }
                                            </li>
                                        }
                                    </ol>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted compact-note">Removing a section here keeps the segment, its history, and its other parent links.</p>
        }
    </section>
    }

    <section class="panel">
        <div class="panel-heading">
            <div><h2>Effort history</h2><p class="muted">Repeated passes remain separate. Speed and pace use the saved segment distance divided by elapsed time. Select a row to inspect its exact recorded stream slice.</p></div>
            <label class="compact-select"><span>Sort by</span><select @bind="_sort"><option value="rank">Rank</option><option value="date">Newest</option><option value="elapsed">Elapsed time</option><option value="speed">Speed / pace</option><option value="heart-rate">Heart rate</option><option value="power">Power</option></select></label>
        </div>
        @if (_segment.Efforts.Count == 0)
        {
            <p class="muted">No matching passes found. Increase the advanced segment tolerance only when the recorded GPS is noisy.</p>
        }
        else
        {
            <div class="effort-table-wrap">
                <table class="effort-table">
                    <thead><tr><th>Rank</th><th>Date</th><th>Elapsed</th><th>Moving</th><th>@(_segment.Summary.Sport == SportKind.Cycling ? "Segment avg speed" : "Segment avg pace")</th><th>Heart rate</th><th>@Format.CadenceLabel(_segment.Summary.Sport)</th><th>Power</th><th>Temperature</th><th>Respiration</th><th>Coverage</th></tr></thead>
                    <tbody>
                    @foreach (var effort in SortedEfforts)
                    {
                        <tr class="@(effort.Id == _segment.SelectedEffortId ? "selected" : null)">
                            <td>#@effort.Rank</td>
                            <td><a href="@EffortUrl(effort.Id)">@effort.StartTime.ToLocalTime().ToString("g")</a></td>
                            <td>@Format.Duration(effort.ElapsedSeconds)</td>
                            <td>@Format.Duration(effort.MovingSeconds)</td>
                            <td>@Format.Speed(effort.AverageSpeed, _segment.Summary.Sport)</td>
                            <td>@Value(effort.AverageHeartRate, "bpm")</td>
                            <td>@Value(effort.AverageCadence, Format.CadenceUnit(_segment.Summary.Sport))</td>
                            <td>@Value(effort.AveragePower, "W")</td>
                            <td>@Value(effort.AverageTemperature, "deg C", 1)</td>
                            <td>@Value(effort.AverageRespiration, "brpm", 1)</td>
                            <td>@($"{effort.CoveragePercent:N0}%")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    var selected = _segment.Efforts.FirstOrDefault(x => x.Id == _segment.SelectedEffortId);
    @if (!IsComparing && selected is not null && _segment.SelectedEffortPoints.Count > 1)
    {
        <section class="panel-heading chart-controls">
            <div><span class="eyebrow">Selected effort #@selected.Rank</span><h2>@selected.StartTime.ToLocalTime().ToString("F")</h2><p class="muted">@Format.Duration(selected.ElapsedSeconds) elapsed - @($"{selected.CoveragePercent:N0}%") data coverage - <a href="@($"/activities/{selected.ActivityId}")">open activity</a></p></div>
            <div class="button-row"><button class="@AxisButton(ChartAxisKind.ElapsedTime)" aria-pressed="@(_axis == ChartAxisKind.ElapsedTime ? "true" : "false")" @onclick="() => _axis = ChartAxisKind.ElapsedTime">Elapsed time</button><button class="@AxisButton(ChartAxisKind.Distance)" aria-pressed="@(_axis == ChartAxisKind.Distance ? "true" : "false")" @onclick="() => _axis = ChartAxisKind.Distance">Distance</button></div>
        </section>
        <section class="panel effort-diagnostics" aria-labelledby="selected-effort-diagnostics">
            <div class="panel-heading">
                <div><h2 id="selected-effort-diagnostics">Recorded effort diagnostics</h2><p class="muted">These values describe the selected GPS and elevation slice. Differences from the saved segment can reflect recording noise or small path variations and do not change the comparison ranking.</p></div>
                <span class="badge">@(selected.MetricsCurrent ? "Current calculation" : "Legacy calculation")</span>
            </div>
            <section class="metric-grid">
                <MetricCard Label="Recorded distance" Value="@Value(selected.RecordedDistance, "m", 1)" Hint="@DiagnosticDifference(selected.RecordedDistance, _segment.Summary.DistanceMeters, "m", 1)" />
                <MetricCard Label="Recorded ascent" Value="@Value(selected.ElevationGain, "m", 1)" Hint="@DiagnosticDifference(selected.ElevationGain, _segment.Summary.ElevationGain, "m", 1)" />
                <MetricCard Label="Recorded descent" Value="@Value(selected.ElevationLoss, "m", 1)" Hint="@DiagnosticDifference(selected.ElevationLoss, _segment.Summary.ElevationLoss, "m", 1)" />
                <MetricCard Label="Recorded grade" Value="@Value(selected.AverageGrade, "%", 1)" Hint="@DiagnosticDifference(selected.AverageGrade, _segment.Summary.AverageGrade, "percentage points", 1)" />
            </section>
        </section>
        <section class="chart-grid synchronized-charts" data-axis-kind="@(_axis == ChartAxisKind.Distance ? "distance" : "time")">
            <TimeSeriesChart Title="Elevation" Unit="m" Points="_segment.SelectedEffortPoints" Selector="@(point => point.ElevationMeters)" Axis="_axis" />
            <TimeSeriesChart Title="@Format.SpeedLabel(_segment.Summary.Sport)" Unit="@Format.SpeedUnit(_segment.Summary.Sport)" Points="_segment.SelectedEffortPoints" Selector="SpeedOrPace" Axis="_axis" SummaryAverage="@SpeedOrPace(selected.AverageSpeed)" SummaryAverageLabel="@(selected.MetricsCurrent ? "Segment elapsed average" : "Legacy sample average")" />
            <TimeSeriesChart Title="Heart rate" Unit="bpm" Points="_segment.SelectedEffortPoints" Selector="@(point => point.HeartRate)" Axis="_axis" SummaryAverage="@selected.AverageHeartRate" SummaryAverageLabel="@SensorAverageLabel(selected)" />
            <TimeSeriesChart Title="@Format.CadenceLabel(_segment.Summary.Sport)" Unit="@Format.CadenceUnit(_segment.Summary.Sport)" Points="_segment.SelectedEffortPoints" Selector="@(point => point.Cadence)" Axis="_axis" SummaryAverage="@selected.AverageCadence" SummaryAverageLabel="@SensorAverageLabel(selected)" />
            <TimeSeriesChart Title="Power" Unit="W" Points="_segment.SelectedEffortPoints" Selector="@(point => point.PowerWatts)" Axis="_axis" EmptyMessage="Not recorded in the source" SummaryAverage="@selected.AveragePower" SummaryAverageLabel="@SensorAverageLabel(selected)" />
            <TimeSeriesChart Title="Temperature" Unit="deg C" Points="_segment.SelectedEffortPoints" Selector="@(point => point.TemperatureCelsius)" Axis="_axis" SummaryAverage="@selected.AverageTemperature" SummaryAverageLabel="@SensorAverageLabel(selected)" />
            <TimeSeriesChart Title="Respiration" Unit="brpm" Points="_segment.SelectedEffortPoints" Selector="@(point => point.RespirationRate)" Axis="_axis" SummaryAverage="@selected.AverageRespiration" SummaryAverageLabel="@SensorAverageLabel(selected)" />
        </section>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "effort")] public Guid? EffortId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "section")] public Guid? SectionId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "baseline")] public string? BaselineId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "comparison")] public string? ComparisonId { get; set; }

    private SegmentDetail? _segment;
    private SegmentComparisonResult? _comparisonResult;
    private string? _comparisonLoadError;
    private CancellationTokenSource? _loadCancellation;
    private bool IsComparing => View == "compare";
    private bool CanSwap => _loaded && Guid.TryParse(BaselineId, out var baseline) && Guid.TryParse(ComparisonId, out var comparison) &&
        baseline != comparison && _segment!.Efforts.Any(effort => effort.Id == baseline) && _segment.Efforts.Any(effort => effort.Id == comparison);
    private string _sort = "rank";
    private ChartAxisKind _axis = ChartAxisKind.ElapsedTime;
    private bool _loaded;
    private bool _recomputing;
    private string? _loadError;
    private string? _recomputeStatus;
    private bool _recomputeFailed;
    private readonly string _definitionExplorerId = $"segment-definition-{Guid.NewGuid():N}";
    private IReadOnlyList<SegmentMapSection> _mapSections = [];
    private Guid? _selectedSectionId;
    private Guid? _loadedId;
    private Guid? _loadedEffortId;
    private string? _loadedView;
    private string? _loadedBaseline;
    private string? _loadedComparison;
    private int _loadVersion;
    private bool _removing;
    private string? _relationshipStatus;
    private bool _relationshipFailed;
    private bool HasLegacyEfforts => _segment?.Efforts.Any(x => !x.MetricsCurrent) == true;
    private string SourceLabel => _segment?.Summary.SourceKind switch
    {
        SegmentSourceKind.ImportedFile => "Imported file",
        SegmentSourceKind.Activity => "Activity selection",
        SegmentSourceKind.Route => "Route selection",
        SegmentSourceKind.Segment => "Segment selection",
        SegmentSourceKind.Drawn => "Drawn locally",
        _ => "Local definition"
    };

    private IEnumerable<SegmentEffortSummary> SortedEfforts => (_segment?.Efforts ?? []).OrderBy(x => _sort switch
    {
        "date" => -x.StartTime.UtcTicks,
        "elapsed" => (long)(x.ElapsedSeconds * 1000),
        "speed" => -(long)((x.AverageSpeed ?? 0) * 1000000),
        "heart-rate" => -(long)((x.AverageHeartRate ?? 0) * 1000),
        "power" => -(long)((x.AveragePower ?? 0) * 1000),
        _ => x.Rank
    });

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedId == Id && _loadedEffortId == EffortId && _loadedView == View &&
            _loadedBaseline == BaselineId && _loadedComparison == ComparisonId && _segment is not null)
        {
            UpdateSectionSelection();
            return;
        }
        _recomputeStatus = null;
        _recomputeFailed = false;
        _relationshipStatus = null;
        _relationshipFailed = false;
        if (_loadedId != Id) _segment = null;
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var id = Id;
        var effortId = EffortId;
        var view = View;
        var baseline = BaselineId;
        var comparison = ComparisonId;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        var token = _loadCancellation.Token;
        _loaded = false;
        _loadError = null;
        _comparisonLoadError = null;
        try
        {
            SegmentDetail? segment;
            SegmentComparisonResult? result = null;
            if (view == "compare")
            {
                result = await SegmentService.GetComparisonAsync(id,
                    Guid.TryParse(baseline, out var baselineGuid) ? baselineGuid : Guid.Empty,
                    Guid.TryParse(comparison, out var comparisonGuid) ? comparisonGuid : Guid.Empty, token);
                segment = result?.Detail;
            }
            else segment = await SegmentService.GetAsync(id, effortId, token);
            if (version != _loadVersion) return;
            _comparisonResult = result;
            ApplySegment(segment);
            _loadedId = id;
            _loadedEffortId = effortId;
            _loadedView = view;
            _loadedBaseline = baseline;
            _loadedComparison = comparison;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch
        {
            if (version != _loadVersion) return;
            _comparisonResult = null;
            if (view == "compare")
            {
                try
                {
                    var metadata = await SegmentService.GetComparisonAsync(id, Guid.Empty, Guid.Empty, token);
                    if (version != _loadVersion) return;
                    ApplySegment(metadata?.Detail);
                    _comparisonLoadError = "The comparison could not be loaded. Retry, or choose another effort.";
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                catch { if (version == _loadVersion) _loadError = "The segment could not be loaded. Try again."; }
            }
            else
            {
                _segment = null;
                _loadError = "The segment could not be loaded. Try again.";
            }
        }
        finally { if (version == _loadVersion) _loaded = true; }
    }
    private async Task Recompute()
    {
        var version = _loadVersion;
        var id = Id;
        _recomputing = true;
        _recomputeStatus = null;
        _recomputeFailed = false;
        try
        {
            await SegmentService.RecomputeAsync(id);
            if (version != _loadVersion) return;
            version++;
            await LoadAsync();
            if (version != _loadVersion) return;
            _recomputeStatus = "Efforts recomputed with fixed-distance speed and timestamp-weighted sensor averages.";
        }
        catch
        {
            if (version != _loadVersion) return;
            _recomputeFailed = true;
            _recomputeStatus = "Efforts could not be recomputed. Existing values were kept; try again.";
        }
        finally { _recomputing = false; }
    }
    private void ApplySegment(SegmentDetail? segment)
    {
        _segment = segment;
        _mapSections = segment?.Children.Select((child, index) => new SegmentMapSection(child.Summary.Id, child.Summary.Name, index + 1, child.Placements)).ToArray() ?? [];
        UpdateSectionSelection();
    }

    private void UpdateSectionSelection() => _selectedSectionId = _mapSections.Any(section => section.Id == SectionId) ? SectionId : null;

    private void SelectSection(Guid sectionId) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("section", sectionId), replace: true);

    private string EffortUrl(Guid effortId) => $"/segments/{Id}?effort={effortId}" + (_selectedSectionId.HasValue ? $"&section={_selectedSectionId}" : string.Empty);

    private bool HasUnknownSelection(string? value) => !string.IsNullOrEmpty(value) &&
        (!Guid.TryParse(value, out var id) || !_segment!.Efforts.Any(effort => effort.Id == id));

    private static string? EffortSelectionValue(string? value) => Guid.TryParse(value, out var id) ? id.ToString() : value;

    private string EffortLabel(SegmentEffortSummary effort)
    {
        var pass = _segment!.Efforts.Where(value => value.ActivityId == effort.ActivityId)
            .OrderBy(value => value.StartPointIndex).TakeWhile(value => value.Id != effort.Id).Count() + 1;
        return $"#{effort.Rank} · {effort.StartTime.ToLocalTime():g} · Pass {pass} · {Format.Duration(effort.ElapsedSeconds)}";
    }

    private void InspectEffort() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["view"] = null, ["baseline"] = null, ["comparison"] = null
    }));

    private void EnterComparison()
    {
        if (IsComparing || _segment is null) return;
        var selected = _segment.Efforts.FirstOrDefault(effort => effort.Id == _segment.SelectedEffortId);
        var best = _segment.Efforts.FirstOrDefault(effort => effort.Id != selected?.Id &&
            effort.ElapsedSeconds == _segment.Summary.BestElapsedSeconds);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = "compare", ["effort"] = EffortId ?? selected?.Id,
            ["baseline"] = best?.Id ?? selected?.Id, ["comparison"] = best is null ? null : selected?.Id
        }));
    }

    private void ChangeBaseline(ChangeEventArgs args) => ChangePair(args.Value?.ToString(), ComparisonId);
    private void ChangeComparison(ChangeEventArgs args) => ChangePair(BaselineId, args.Value?.ToString());
    private void SwapEfforts() => ChangePair(ComparisonId, BaselineId);
    private void ChangePair(string? baseline, string? comparison) => Navigation.NavigateTo(
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = "compare", ["baseline"] = string.IsNullOrEmpty(baseline) ? null : baseline,
            ["comparison"] = string.IsNullOrEmpty(comparison) ? null : comparison
        }));

    public void Dispose()
    {
        ++_loadVersion;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        GC.SuppressFinalize(this);
    }

    private async Task RemoveSection(Guid childId)
    {
        var version = _loadVersion;
        var id = Id;
        var effortId = EffortId;
        _removing = true;
        _relationshipFailed = false;
        _relationshipStatus = null;
        try
        {
            await SegmentService.DetachAsync(id, childId);
            var segment = await SegmentService.GetAsync(id, effortId);
            if (version != _loadVersion) return;
            ApplySegment(segment);
            _relationshipStatus = "Section removed from this segment. Its history and other links were kept.";
            if (SectionId == childId) Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("section", (Guid?)null), replace: true);
        }
        catch
        {
            if (version != _loadVersion) return;
            _relationshipFailed = true;
            _relationshipStatus = "The relationship could not be refreshed. Reload the page to check it before trying again.";
        }
        finally { _removing = false; }
    }
    private string AxisButton(ChartAxisKind axis) => _axis == axis ? "button primary" : "button";
    private static string Value(double? value, string unit, int decimals = 0) =>
        value.HasValue ? $"{value.Value.ToString($"N{decimals}")} {unit}".TrimEnd() : "--";

    private double? SpeedOrPace(TrackPoint point)
    {
        return SpeedOrPace(point.SpeedMetersPerSecond);
    }

    private double? SpeedOrPace(double? speedMetersPerSecond)
    {
        return Format.SpeedOrPace(speedMetersPerSecond, _segment!.Summary.Sport);
    }

    private static string SensorAverageLabel(SegmentEffortSummary effort) =>
        effort.MetricsCurrent ? "Time-weighted average" : "Legacy sample average";

    private static string DiagnosticDifference(double? recorded, double? canonical, string unit, int decimals)
    {
        if (!recorded.HasValue || !canonical.HasValue) return "Difference unavailable";
        var zeroes = new string('0', decimals);
        var pattern = decimals == 0 ? "+0;-0;0" : $"+0.{zeroes};-0.{zeroes};0.{zeroes}";
        return $"Difference from saved: {(recorded.Value - canonical.Value).ToString(pattern)} {unit}";
    }
}
