@page "/goals"
@implements IDisposable
@inject IGoalService GoalService
@inject ProfileState Profiles
@inject NavigationManager Navigation
@inject ILogger<Goals> Logger

<PageTitle>Goals - Activity Explorer</PageTitle>
<PageHeader Title="Goals"><Actions><a class="button primary" href="/goals/new">New goal</a></Actions></PageHeader>
<form class="filter-bar" aria-label="Goal filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
    <label><span>Goal view</span><select @bind="_view" @bind:after="ChangeView"><option value="current">Current and upcoming</option><option value="all">All</option><option value="archived">Archived</option></select></label>
    <label><span>Goal name</span><input type="search" @bind="_search" @bind:event="oninput" @bind:after="FiltersEdited" /></label>
    <label><span>Goal sport</span><select @bind="_sport" @bind:after="FiltersEdited"><option value="">Any sport</option>@foreach (var sport in Format.Sports) { <option value="@sport">@sport</option> }</select></label>
    <label><span>Goal metric</span><select @bind="_metric" @bind:after="FiltersEdited"><option value="">Any metric</option>@foreach (var metric in Enum.GetValues<GoalMetric>()) { <option value="@metric">@GoalDisplay.Label(metric)</option> }</select></label>
    <label><span>Goal progress</span><select @bind="_progress" @bind:after="FiltersEdited"><option value="any">Any progress</option><option value="reached">Target reached</option><option value="unreached">Target not reached</option></select></label>
    <button class="button primary" type="submit">Apply goal filters</button>
    <button class="button" type="button" @onclick="ResetFiltersAsync">Reset goal filters</button>
    <button class="button" type="button" @onclick="LoadAsync" disabled="@(_loading || _dirty)">Refresh goals</button>
</form>
@if (_dirty) { <p class="notice" role="status">Apply goal filters to update these results.</p> }
@if (_loading) { <p class="loading" role="status">Loading goals...</p> }
else if (_error is not null) { <section class="notice error" role="alert"><p>@_error</p><button class="button" @onclick="LoadAsync">Try again</button></section> }
else if (_goals.Count == 0 && HasFindingFilters)
{
    <section class="empty-state"><h2>No matching goals</h2><p>Adjust the name, sport, metric, or progress filters.</p><button class="button" @onclick="ResetFiltersAsync">Show all goals in this view</button>@if (_view != "all") { <a class="button" href="@BuildUri("all")">View all goals</a> }</section>
}
else if (_goals.Count == 0)
{
    <section class="empty-state"><h2>No goals in this view</h2><p>Set a target for your distance, moving time, ascent, activities, or active days.</p><a class="button primary" href="/goals/new">Create a goal</a>@if (_view != "all") { <a class="button" href="/goals?view=all">View all goals</a> }</section>
}
else
{
    <p class="muted" role="status">@_goals.Count.ToString("N0") matching @(_goals.Count == 1 ? "goal" : "goals")</p>
    <div class="goal-list">
    @foreach (var item in _goals)
    {
        <article class="panel" @key="item.Goal.Id">
            <div class="panel-heading"><h2><a href="@GoalDisplay.Url(item.Goal.Id)">@item.Goal.Definition.Name</a></h2><span>@GoalDisplay.Recurrence(item.Goal.Schedule.Recurrence)</span></div>
            <p class="goal-owner">@item.Goal.OwnerName · @item.Goal.TimeZoneId@if (item.Goal.Archived) { <text> · Archived</text> }</p>
            @if (item.Error is not null) { <p class="notice error">@item.Error <a href="/profiles">Open Profiles</a></p> }
            else if (item.Edition is not null) { <GoalProgress Edition="item.Edition" Metric="item.Goal.Schedule.Metric" /> }
            else { <p>This goal was archived before its first edition began.</p> }
        </article>
    }
    </div>
}
<p class="muted">Progress uses current activity summaries. Imports, corrections, deletions, transfers, and reporting timezone changes can change results, including past editions.</p>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? QueryView { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "sport")] public string? QuerySport { get; set; }
    [SupplyParameterFromQuery(Name = "metric")] public string? QueryMetric { get; set; }
    [SupplyParameterFromQuery(Name = "progress")] public string? QueryProgress { get; set; }
    private string _view = "current";
    private string _search = "", _sport = "", _metric = "", _progress = "any";
    private IReadOnlyList<GoalSummary> _goals = [];
    private bool _loading, _disposed, _dirty;
    private string? _error;
    private int _revision;
    private CancellationTokenSource? _load;
    protected override void OnInitialized() => Profiles.Changed += ProfileChanged;
    protected override Task OnParametersSetAsync()
    {
        _view = QueryView is "all" or "archived" ? QueryView : "current";
        _search = QuerySearch ?? "";
        _sport = Enum.TryParse<SportKind>(QuerySport, true, out var sport) && Enum.IsDefined(sport) ? sport.ToString() : QuerySport ?? "";
        _metric = Enum.TryParse<GoalMetric>(QueryMetric, true, out var metric) && Enum.IsDefined(metric) ? metric.ToString() : QueryMetric ?? "";
        _progress = QueryProgress ?? "any";
        _dirty = false;
        return LoadAsync();
    }
    private Task ChangeView() { FiltersEdited(); return ApplyAsync(); }
    private async Task LoadAsync()
    {
        _load?.Cancel();
        using var load = new CancellationTokenSource(); _load = load;
        var revision = ++_revision; _loading = true; _error = null; _goals = [];
        try
        {
            var result = await GoalService.SearchAsync(CurrentFilter(), load.Token);
            if (!_disposed && revision == _revision) { _goals = result; _dirty = false; }
        }
        catch (OperationCanceledException) when (load.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load goals");
            if (!_disposed && revision == _revision) _error = exception is ArgumentException or InvalidOperationException ? exception.Message : "Goals could not be loaded. Try again.";
        }
        finally { if (revision == _revision) { _loading = false; _load = null; } }
    }
    private void ProfileChanged() => _ = InvokeAsync(async () => { if (_disposed) return; var task = LoadAsync(); StateHasChanged(); await task; if (!_disposed) StateHasChanged(); });
    public void Dispose() { _disposed = true; _revision++; _load?.Cancel(); _load = null; Profiles.Changed -= ProfileChanged; }
}
