@page "/routes/{Id:guid}"
@implements IDisposable
@inject IRouteService RouteService
@inject ISegmentService SegmentService
@inject NavigationManager Navigation
@using ActivityExplorer.Web.Components.Shared

<PageTitle>@(_route?.Summary.Name ?? (_loadError is not null ? "Route unavailable" : _loaded ? "Route not found" : "Route")) - Activity Explorer</PageTitle>
@if (!_loaded) { <div class="loading" role="status">Loading route...</div> }
else if (_loadError is not null) { <section class="empty-state"><h1>Route unavailable</h1><p>@_loadError</p><button class="button" type="button" @onclick="LoadAsync">Try again</button></section> }
else if (_route is null) { <section class="empty-state"><h1>Route not found</h1><p>This route may have been deleted or the link is no longer valid.</p><a class="button" href="/routes">Back to routes</a></section> }
else
{
    <PageHeader Title="@_route.Summary.Name" Summary="@_route.Description">
        <Metadata><span>@_route.Summary.Sport</span><span>@_route.Summary.OwnerName</span></Metadata>
        <Actions><a class="button primary" href="@($"/internal/routes/{Id}.gpx")" download>Export GPX</a></Actions>
    </PageHeader>
    @if (CleanupPending)
    {
        <StatusMessage Message="The route was imported. File cleanup is pending and will be retried at startup; you can use this route without importing it again." IsWarning="true" />
    }
    <section class="metric-grid"><MetricCard Label="Distance" Value="@Format.Distance(_route.Summary.DistanceMeters)" /><MetricCard Label="Elevation" Value="@($"{_route.Summary.ElevationMeters:N0} m")" /><MetricCard Label="Track points" Value="@_route.Points.Count.ToString("N0")" /></section>
    <SegmentCreatorWorkspace SourceId="Id" SourceLabel="route" Points="_route.Points"
                             InitialName="@_route.Summary.Name" Busy="_creating" ErrorMessage="@_message"
                             OnCreate="CreateSegment" />
}
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "cleanupPending")] public bool CleanupPending { get; set; }
    private RouteDetail? _route;
    private string? _message;
    private bool _loaded;
    private bool _creating;
    private string? _loadError;
    private CancellationTokenSource? _sourceCancellation;
    private int _sourceVersion;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_disposed) return;
        _sourceCancellation?.Cancel();
        _sourceCancellation?.Dispose();
        _sourceCancellation = new();
        var token = _sourceCancellation.Token;
        var version = ++_sourceVersion;
        var routeId = Id;
        _loaded = false;
        _creating = false;
        _route = null;
        _loadError = null;
        _message = null;
        try
        {
            var route = await RouteService.GetAsync(routeId, token);
            if (IsCurrentSource(version)) _route = route;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch
        {
            if (!IsCurrentSource(version)) return;
            _route = null;
            _loadError = "The route could not be loaded. Try again.";
        }
        finally { if (IsCurrentSource(version)) _loaded = true; }
    }

    private async Task CreateSegment(SegmentCreatorSubmission submission)
    {
        if (_disposed || _creating || !_loaded || _route is null) return;
        var route = _route;
        var version = _sourceVersion;
        var token = _sourceCancellation!.Token;
        _creating = true;
        _message = null;
        try
        {
            IEnumerable<TrackPoint> selected = route.Points.Skip(submission.StartIndex).Take(submission.EndIndex - submission.StartIndex + 1);
            if (submission.ReverseDirection) selected = selected.Reverse();
            var id = await SegmentService.CreateAsync(new CreateSegmentPathRequest(
                route.Summary.OwnerId,
                submission.Name,
                route.Summary.Sport,
                selected.ToArray(),
                submission.ToleranceMeters,
                SourceKind: SegmentSourceKind.Route,
                SourceName: route.Summary.Name), token);
            if (IsCurrentSource(version)) Navigation.NavigateTo($"/segments/{id}");
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) { if (IsCurrentSource(version)) _message = exception.Message; }
        finally { if (IsCurrentSource(version)) _creating = false; }
    }

    private bool IsCurrentSource(int version) => !_disposed && version == _sourceVersion;

    public void Dispose()
    {
        _disposed = true;
        _sourceVersion++;
        _sourceCancellation?.Cancel();
        _sourceCancellation?.Dispose();
    }
}
