@page "/"
@implements IDisposable
@inject IActivityQueryService Activities
@inject ProfileState ProfileState
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject ILogger<Home> Logger

<PageTitle>Dashboard - Activity Explorer</PageTitle>
<PageHeader Title="Dashboard"><Actions><a class="button" href="@CalendarUrl">Training calendar</a></Actions></PageHeader>
<form class="filter-bar progress-filters" aria-label="Dashboard filters" @onsubmit="Apply" @onsubmit:preventDefault>
    <label><span>Sport</span><select @bind="_sport" @bind:after="FiltersChanged"><option value="">All sports</option>@foreach (var sport in Format.Sports) { <option value="@sport.ToString().ToLowerInvariant()">@sport</option> }</select></label>
    <ReportingDateFilter Value="_dates" Periods="_previewPeriods" Error="@_dateError" Changed="FiltersChanged" />
    <label><span>Compare with</span><select @bind="_comparison" @bind:after="FiltersChanged"><option value="prior-year">Prior-year dates</option><option value="previous-period">Previous period</option></select></label>
    <button class="button primary" type="submit" disabled="@(_dateError is not null)">Apply filters</button>
    <button class="button" type="button" @onclick="Refresh" disabled="@(_dirty || _loading)">Refresh dashboard</button>
</form>
@if (_dirty) { <p class="notice" role="status">Apply filters to update these results.</p> }
@if (_error is not null) { <section class="notice error" role="alert"><p>@_error</p><button class="button" @onclick="LoadAsync" disabled="@_dirty">Try again</button></section> }
@if (_loading) { <div class="loading" role="status">Loading dashboard...</div> }
@if (_summary is not null)
{
    @if (!_summary.HasAnyActivities)
    {
        <section class="empty-state"><h2>Bring your history home</h2><p>Import activity files to start exploring your training history.</p><a class="button primary" href="/imports">Start your first import</a></section>
    }
    <section class="metric-grid five progress-totals" aria-label="Period totals">
        @foreach (var metric in ProgressDisplay.Metrics)
        {
            <MetricCard Label="@ProgressDisplay.Label(metric)" Value="@ProgressDisplay.FormatValue(metric, ProgressDisplay.Value(_summary.Totals, metric))" Hint="@ComparisonHint(metric)" />
        }
    </section>
    <div class="comparison-context">
        @if (_summary.ComparisonTotals is not null)
        {
            <p><strong>Selected:</strong> @Ranges(_summary.Periods) · <strong>Compared with:</strong> @Ranges(_summary.ComparisonPeriods)</p>
            @if (_summary.Periods.Select(x => (x.From, x.To)).Distinct().Count() > 1 || _summary.ComparisonPeriods.Select(x => (x.From, x.To)).Distinct().Count() > 1)
            {
                <details><summary>Comparison dates by profile</summary><ul>@foreach (var period in _summary.Periods)
                {
                    var comparison = _summary.ComparisonPeriods.Single(x => x.OwnerId == period.OwnerId);
                    <li><strong>@period.OwnerName:</strong> @Range(period.From, period.To) compared with @Range(comparison.From, comparison.To) · @period.TimeZoneId</li>
                }</ul></details>
            }
        }
        else { <p>@_summary.ComparisonUnavailableReason</p> }
        <p>Active days counts dates with any matching activity. Each profile uses its reporting timezone; shared dates count once in All profiles.</p>
    </div>
    @if (_summary.HasAnyActivities && _summary.Totals.ActivityCount == 0)
    {
        <section class="notice"><h2>No activities in this period</h2><p>Choose a different sport or period, or <a href="@AllTimeUrl">view all time</a>.</p></section>
    }
    <section class="panel progress-trend" aria-label="Training trend">
        <div class="panel-heading"><h2>Training trend</h2><div class="trend-controls">
            <label><span>Trend grouping</span><select @bind="_grouping" @bind:after="ChangeTrend" disabled="@_dirty"><option value="monthly">Monthly</option><option value="weekly">Weekly</option></select></label>
            <label><span>Trend metric</span><select @bind="_metric" @bind:after="ChangeTrend" disabled="@_dirty">@foreach (var metric in ProgressDisplay.Metrics) { <option value="@metric">@ProgressDisplay.Label(metric)</option> }</select></label>
        </div></div>
        @if (_summary.Trend.Count == 0) { <p class="muted">No matching dates to chart.</p> }
        else
        {
            <SparkChart @key="_metric + _grouping" Title="@($"{ProgressDisplay.Label(_metric)} by {(_grouping == "weekly" ? "week" : "month")}")"
                        Unit="@ProgressDisplay.Unit(_metric)" IncludeZero="true" Values="@TrendValues" Labels="@TrendLabels"
                        AxisLabel="@(_grouping == "weekly" ? "Week" : "Month")" ValueLabel="@ProgressDisplay.Label(_metric)"
                        ValueFormatter="@TrendValue" AxisLabels="@TrendAxisLabels" />
        }
    </section>
    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-heading"><h2>By sport</h2><a href="@ActivitiesUrl">Browse this period</a></div>
            @if (_summary.Sports.Count == 0) { <p class="muted">No matching activities.</p> }
            @foreach (var sport in _summary.Sports.OrderBy(x => x.Sport))
            {
                <div class="sport-row"><span class="sport-dot @sport.Sport.ToString().ToLowerInvariant()"></span><strong>@sport.Sport</strong><span>@sport.Count activities</span><span>@Format.Distance(sport.DistanceMeters)</span><span>@Format.Duration(sport.MovingSeconds)</span></div>
            }
        </article>
        <article class="panel">
            <div class="panel-heading"><h2>Lifetime records</h2><a href="@RecordsUrl">View all records</a></div>
            @if (_summary.Highlights.Count == 0) { <p class="muted">No records for this profile and sport.</p> }
            @foreach (var record in _summary.Highlights)
            {
                <div class="record-row"><span><a href="@HistoryUrl(record)">@record.Sport · @record.Key progress</a><strong>@RecordDisplay.Value(record.Sport, record.Kind, record.Value)</strong>@if (!ProfileState.SelectedOwnerId.HasValue) { <small>@record.OwnerName</small> }</span><a href="@($"/activities/{record.ActivityId}")" aria-label="@($"Open {record.ActivityTitle}")">Activity →</a></div>
            }
        </article>
    </section>
    <CurrentGoals RefreshKey="_revision" />
    <section class="dashboard-grid">
        <article class="panel progress-recent">
            <div class="panel-heading"><h2>Recent activities in this period</h2><a href="@ActivitiesUrl">Browse all</a></div>
            <div class="activity-list">@foreach (var activity in _summary.Recent)
            {
                <a class="activity-row" href="@($"/activities/{activity.Id}")"><span class="sport-icon @activity.Sport.ToString().ToLowerInvariant()">@activity.Sport.ToString()[0]</span><span class="activity-title"><strong>@activity.Title</strong><small>@activity.OwnerName · @LocalDate(activity).ToString("d")</small></span><span><strong>@Format.Distance(activity.DistanceMeters)</strong><small>distance</small></span><span><strong>@Format.Duration(activity.MovingSeconds)</strong><small>moving</small></span></a>
            }</div>
        </article>
        <article class="panel"><div class="panel-heading"><h2>Devices and gear in this period</h2></div>
            @if (_summary.Devices.Count == 0 && _summary.Gear.Count == 0) { <p class="muted">Device and gear names appear when supplied by source files.</p> }
            @foreach (var device in _summary.Devices) { <div class="compact-row"><strong>@device.Name</strong><span>@device.Count activities</span><small>device</small></div> }
            @foreach (var item in _summary.Gear) { <div class="compact-row"><strong>@item.Name</strong><span>@item.Count activities</span><small>gear</small></div> }
        </article>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "sport")] public string? QuerySport { get; set; }
    [SupplyParameterFromQuery(Name = "period")] public string? QueryPeriod { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "compare")] public string? QueryComparison { get; set; }
    [SupplyParameterFromQuery(Name = "group")] public string? QueryGrouping { get; set; }
    [SupplyParameterFromQuery(Name = "metric")] public string? QueryMetric { get; set; }
    private DashboardSummary? _summary;
    private ReportingDateInput _dates = new() { Period = "year-to-date" };
    private IReadOnlyList<ResolvedOwnerPeriod> _previewPeriods = [];
    private string _sport = "", _comparison = "prior-year", _grouping = "monthly", _metric = "distance";
    private string? _dateError, _error;
    private bool _loading, _dirty, _disposed;
    private int _revision;
    private CancellationTokenSource? _cancellation;
    protected override void OnInitialized() => ProfileState.Changed += ProfileChanged;
    protected override async Task OnParametersSetAsync()
    {
        _sport = RecordDisplay.Parse<SportKind>(QuerySport)?.ToString().ToLowerInvariant() ?? "";
        _dates = AppliedDates;
        _comparison = QueryComparison == "previous-period" ? "previous-period" : "prior-year";
        _grouping = QueryGrouping == "weekly" ? "weekly" : "monthly";
        _metric = ProgressDisplay.Metrics.Contains(QueryMetric) ? QueryMetric! : "distance";
        _dirty = false;
        await LoadAsync();
    }
    private bool ValidateDates()
    {
        try
        {
            var selection = _dates.Selection;
            var instant = Clock.GetUtcNow();
            _previewPeriods = ProfileState.Profiles.Where(x => !ProfileState.SelectedOwnerId.HasValue || x.Id == ProfileState.SelectedOwnerId)
                .Select(x => ReportingDates.Resolve(selection, x.Id, x.DisplayName, x.TimeZoneId, instant)).ToArray();
            _dateError = null;
            return true;
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        { _previewPeriods = []; _dateError = exception.Message; return false; }
    }
    private async Task LoadAsync()
    {
        CancelCurrentLoad();
        var revision = ++_revision;
        _summary = null;
        _error = null;
        _loading = false;
        if (!ValidateDates()) return;
        using var cancellation = new CancellationTokenSource();
        _cancellation = cancellation;
        _loading = true;
        try
        {
            var summary = await Activities.GetDashboardAsync(new DashboardQuery(ProfileState.SelectedOwnerId, RecordDisplay.Parse<SportKind>(_sport),
                _dates.Selection, _comparison == "previous-period" ? PeriodComparison.PreviousPeriod : PeriodComparison.PriorYear,
                _grouping == "weekly" ? TrendGranularity.Weekly : TrendGranularity.Monthly, Clock.GetUtcNow()), cancellation.Token);
            if (_disposed || revision != _revision || cancellation.IsCancellationRequested) return;
            _summary = summary;
            _previewPeriods = summary.Periods;
            _dirty = false;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (revision != _revision || _disposed) return;
            Logger.LogError(exception, "Could not load dashboard");
            _error = exception is ArgumentException ? exception.Message : "The dashboard could not be loaded. Try again.";
        }
        finally { if (revision == _revision) { _loading = false; _cancellation = null; } }
    }
    private void FiltersChanged()
    {
        CancelCurrentLoad();
        _revision++;
        _loading = false;
        _dirty = true;
        ValidateDates();
    }
    private Task Apply() => ValidateDates() ? NavigateOrLoad() : Task.CompletedTask;
    private Task Refresh() => LoadAsync();
    private Task ChangeTrend() => NavigateOrLoad();
    private async Task NavigateOrLoad()
    {
        var target = BuildUrl();
        if (new Uri(Navigation.Uri).PathAndQuery == target) await LoadAsync();
        else Navigation.NavigateTo(target);
    }
    private void ProfileChanged()
    {
        CancelCurrentLoad();
        _revision++;
        _summary = null;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            var loading = OnParametersSetAsync();
            StateHasChanged();
            await loading;
            if (!_disposed) StateHasChanged();
        });
    }
    private string BuildUrl()
    {
        var fields = DateFields(_dates).ToList();
        if (_sport.Length > 0) fields.Add($"sport={_sport}");
        fields.Add($"compare={_comparison}"); fields.Add($"group={_grouping}"); fields.Add($"metric={_metric}");
        return "/?" + string.Join('&', fields);
    }
    private static IEnumerable<string> DateFields(ReportingDateInput dates)
    {
        yield return "period=" + Uri.EscapeDataString(dates.Period);
        if (dates.Period == "custom")
        {
            if (dates.From.Length > 0) yield return "from=" + Uri.EscapeDataString(dates.From);
            if (dates.To.Length > 0) yield return "to=" + Uri.EscapeDataString(dates.To);
        }
    }
    private ReportingDateInput AppliedDates => ReportingDateInput.FromQuery(QueryPeriod ?? (string.IsNullOrWhiteSpace(QueryFrom) && string.IsNullOrWhiteSpace(QueryTo) ? "year-to-date" : null), QueryFrom, QueryTo);
    private string AppliedSport => RecordDisplay.Parse<SportKind>(QuerySport)?.ToString().ToLowerInvariant() ?? "";
    private string ActivitiesUrl => "/activities?" + string.Join('&', DateFields(AppliedDates)) + (AppliedSport.Length > 0 ? $"&sport={AppliedSport}" : "");
    private string AllTimeUrl => "/?period=all-time" + (AppliedSport.Length > 0 ? $"&sport={AppliedSport}" : "");
    private string RecordsUrl => "/records" + (AppliedSport.Length > 0 ? $"?sport={AppliedSport}" : "");
    private string CalendarUrl
    {
        get
        {
            var last = _summary?.Periods.Where(x => x.To.HasValue).Select(x => x.To!.Value).DefaultIfEmpty().Max();
            var zone = ProfileState.Profiles.FirstOrDefault(x => x.Id == ProfileState.SelectedOwnerId)?.TimeZoneId;
            DateOnly month;
            try { month = last is { Year: > 1 } ? last.Value : DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), ReportingTimeZone.Resolve(zone)).DateTime); }
            catch (InvalidOperationException) { return "/calendar"; }
            return $"/calendar?month={month:yyyy-MM}" + (AppliedSport.Length > 0 ? $"&sport={AppliedSport}" : "");
        }
    }
    private string HistoryUrl(PersonalRecord record) => RecordDisplay.AttemptsUrl(record.Sport, record.Kind, record.Key, RecordScope.All, ProfileState.SelectedOwnerId)
        + "&view=progress&" + string.Join('&', DateFields(AppliedDates));
    private DateTimeOffset LocalDate(ActivitySummary activity) => TimeZoneInfo.ConvertTime(activity.StartTime, ReportingTimeZone.Resolve(_summary!.Periods.Single(x => x.OwnerId == activity.OwnerId).TimeZoneId));
    private string? ComparisonHint(string metric) => _summary?.ComparisonTotals is { } comparison
        ? ProgressDisplay.Comparison(metric, ProgressDisplay.Value(_summary.Totals, metric), ProgressDisplay.Value(comparison, metric)) : null;
    private double?[] TrendValues => _summary!.Trend.Select(x => (double?)ProgressDisplay.ChartValue(x.Totals, _metric)).ToArray();
    private string[] TrendLabels => _summary!.Trend.Select(x => Range(x.Start, x.End)).ToArray();
    private string[] TrendAxisLabels => _summary!.Trend.Select(x => _grouping == "weekly" ? x.Start.ToString("dd MMM", CultureInfo.CurrentCulture) : x.Start.ToString("MMM yyyy", CultureInfo.CurrentCulture)).ToArray();
    private string TrendValue(double value) => ProgressDisplay.FormatValue(_metric, _metric == "distance" ? value * 1000 : _metric == "moving" ? value * 3600 : value);
    private static string Range(DateOnly? from, DateOnly? to) => (from, to) switch
    {
        (null, null) => "All time", (null, not null) => $"Through {to:dd MMM yyyy}", (not null, null) => $"From {from:dd MMM yyyy}",
        _ when from == to => $"{from:dd MMM yyyy}", _ => $"{from:dd MMM yyyy} – {to:dd MMM yyyy}"
    };
    private static string Ranges(IReadOnlyList<ResolvedOwnerPeriod> periods)
    {
        var ranges = periods.Select(x => (x.From, x.To)).Distinct().ToArray();
        return ranges.Length == 1 ? Range(ranges[0].From, ranges[0].To) : "Dates vary by profile";
    }
    private void CancelCurrentLoad() { var cancellation = _cancellation; _cancellation = null; cancellation?.Cancel(); }
    public void Dispose() { _disposed = true; _revision++; CancelCurrentLoad(); ProfileState.Changed -= ProfileChanged; }
}
