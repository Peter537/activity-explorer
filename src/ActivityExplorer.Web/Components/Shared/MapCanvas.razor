@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IMapSettingsService MapSettings
@using ActivityExplorer.Core.Domain

@if (Editable)
{
    <p id="@($"{_id}-instructions")" class="map-keyboard-help">Pan or zoom the map with its keyboard controls, then use Add point at map center. Undo and Clear are also keyboard-operable.</p>
}
<div id="@_id" class="@CssClass" data-inspection-map="@(string.IsNullOrWhiteSpace(InspectionGroupId) ? null : "true")"></div>
@if (ShowLoadStatus && !string.IsNullOrEmpty(_layerStatus))
{
    <div class="map-load-status" role="@(_layersFailed ? "alert" : "status")">
        <p>@_layerStatus</p>
        @if (_layersFailed) { <button class="button" type="button" @onclick="RetryLayersAsync">@(_cellsView ? "Retry map cells" : "Retry map lines")</button> }
    </div>
}
@if (Editable)
{
    <div class="map-keyboard-controls"><button class="button" type="button" @onclick="AddCenterPointAsync">Add point at map center</button><span role="status" aria-live="polite">@_pointStatus</span></div>
}
@if (ShowDisclosure && _mode == MapPrivacyMode.OpenFreeMap)
{
    <p class="map-disclosure">OpenFreeMap receives the map area you view. Activity tracks remain served only by this local app.</p>
}

@code {
    [Parameter] public string CssClass { get; set; } = "map-canvas";
    [Parameter] public string Label { get; set; } = "Activity map";
    [Parameter] public string? ActivityUrl { get; set; }
    [Parameter] public string? RouteUrl { get; set; }
    [Parameter] public string? SegmentUrl { get; set; }
    [Parameter] public string? ExplorationUrl { get; set; }
    [Parameter] public string? ExplorationView { get; set; }
    [Parameter] public int? SelectedCellId { get; set; }
    [Parameter] public EventCallback<int> SelectedCellIdChanged { get; set; }
    [Parameter] public EventCallback ExplorationInvalidated { get; set; }
    [Parameter] public EventCallback<ExplorationSummary> ExplorationSummaryChanged { get; set; }
    [Parameter] public IReadOnlyList<TrackPoint>? InlinePoints { get; set; }
    [Parameter] public IReadOnlyList<TrackPoint>? HighlightPoints { get; set; }
    [Parameter] public ActivityMapProjection? ActivityTrack { get; set; }
    [Parameter] public ActivityMapProjection? ActivitySelection { get; set; }
    [Parameter] public ActivityMapProjection? BaselineComparisonTrack { get; set; }
    [Parameter] public ActivityMapProjection? ComparisonTrack { get; set; }
    [Parameter] public IReadOnlyList<SegmentMapSection> Sections { get; set; } = [];
    [Parameter] public Guid? SelectedSectionId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedSectionIdChanged { get; set; }
    [Parameter] public int? SelectionStartIndex { get; set; }
    [Parameter] public int? SelectionEndIndex { get; set; }
    [Parameter] public bool SelectionReversed { get; set; }
    [Parameter] public bool ShowSelectionEndpoints { get; set; }
    [Parameter] public string? InspectionGroupId { get; set; }
    [Parameter] public bool ShowDisclosure { get; set; }
    [Parameter] public bool ShowLoadStatus { get; set; }
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<TrackPoint>> PointsChanged { get; set; }
    private readonly string _id = $"map-{Guid.NewGuid():N}";
    private DotNetObjectReference<MapCanvas>? _reference;
    private bool _initialized;
    private bool _disposed;
    private int? _renderedSelectionStart;
    private int? _renderedSelectionEnd;
    private bool _renderedSelectionReversed;
    private ActivityMapProjection? _renderedActivityTrack;
    private ActivityMapProjection? _renderedActivitySelection;
    private ActivityMapProjection? _renderedBaselineComparisonTrack;
    private ActivityMapProjection? _renderedComparisonTrack;
    private IReadOnlyList<TrackPoint>? _renderedHighlightPoints;
    private IReadOnlyList<SegmentMapSection>? _renderedSections;
    private Guid? _renderedSectionId;
    private string _pointStatus = "No points added.";
    private MapPrivacyMode _mode = MapPrivacyMode.Blank;
    private string _layerStatus = "Loading map lines...";
    private bool _layersFailed;
    private bool _cellsView => ExplorationView is "frequency" or "exploration";
    private int _layerRevision;
    private (string?, string?, string?, string?, string?, string, int?) _renderedLayers;
    private (string?, string?, string?, string?, string?, string, int?) CurrentLayers =>
        (ActivityUrl, RouteUrl, SegmentUrl, ExplorationUrl, ExplorationView, Label, SelectedCellId);

    protected override async Task OnInitializedAsync() => _mode = await MapSettings.GetModeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        var activityTrack = ActivityTrack;
        var activitySelection = ActivitySelection;
        var baselineComparisonTrack = BaselineComparisonTrack;
        var comparisonTrack = ComparisonTrack;
        var highlightPoints = HighlightPoints;
        var sections = Sections;
        var sectionId = SelectedSectionId;
        var selectionStart = SelectionStartIndex;
        var selectionEnd = SelectionEndIndex;
        var selectionReversed = SelectionReversed;
        var layers = CurrentLayers;
        if (!firstRender)
        {
            if (_initialized && _renderedLayers != layers)
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateLayers", _id, new
                {
                    activityUrl = layers.Item1, routeUrl = layers.Item2, segmentUrl = layers.Item3,
                    explorationUrl = layers.Item4, explorationView = layers.Item5, label = layers.Item6,
                    selectedCellId = layers.Item7
                });
                _renderedLayers = layers;
            }
            if (_initialized && !ReferenceEquals(_renderedHighlightPoints, highlightPoints))
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateHighlight", _id, Coordinates(highlightPoints));
                _renderedHighlightPoints = highlightPoints;
            }
            if (_initialized && (!ReferenceEquals(_renderedBaselineComparisonTrack, baselineComparisonTrack) ||
                                 !ReferenceEquals(_renderedComparisonTrack, comparisonTrack)))
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateComparison", _id, baselineComparisonTrack, comparisonTrack);
                _renderedBaselineComparisonTrack = baselineComparisonTrack;
                _renderedComparisonTrack = comparisonTrack;
            }
            if (_initialized && !ReferenceEquals(_renderedActivityTrack, activityTrack))
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateActivity", _id, activityTrack, activitySelection);
                _renderedActivityTrack = activityTrack;
                _renderedActivitySelection = activitySelection;
            }
            else if (_initialized && !ReferenceEquals(_renderedActivitySelection, activitySelection))
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateActivitySelection", _id, activitySelection);
                _renderedActivitySelection = activitySelection;
            }
            if (_initialized && (_renderedSelectionStart != selectionStart ||
                                 _renderedSelectionEnd != selectionEnd ||
                                 _renderedSelectionReversed != selectionReversed))
            {
                await JS.InvokeVoidAsync(
                    "activityExplorerMap.updateSelection",
                    _id,
                    selectionStart,
                    selectionEnd,
                    selectionReversed);
                RememberSelection(selectionStart, selectionEnd, selectionReversed);
            }
            if (_initialized && (!ReferenceEquals(_renderedSections, sections) || _renderedSectionId != sectionId))
            {
                await JS.InvokeVoidAsync("activityExplorerMap.updateSections", _id, sections, sectionId);
                _renderedSections = sections;
                _renderedSectionId = sectionId;
            }
            if (_initialized && !_disposed && HasPendingUpdates) await InvokeAsync(StateHasChanged);
            return;
        }
        var coordinates = Coordinates(InlinePoints);
        var highlightCoordinates = Coordinates(highlightPoints);
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("activityExplorerMap.create", _id, new
        {
            activityUrl = ActivityUrl,
            routeUrl = RouteUrl,
            segmentUrl = SegmentUrl,
            explorationUrl = ExplorationUrl,
            explorationView = ExplorationView,
            selectedCellId = SelectedCellId,
            inlineCoordinates = coordinates,
            highlightCoordinates,
            activityTrack,
            activitySelection,
            baselineComparisonTrack,
            comparisonTrack,
            sections,
            selectedSectionId = sectionId,
            selectionStartIndex = selectionStart,
            selectionEndIndex = selectionEnd,
            selectionReversed,
            showSelectionEndpoints = ShowSelectionEndpoints,
            inspectionGroupId = InspectionGroupId,
            blankBaseMap = _mode != MapPrivacyMode.OpenFreeMap,
            styleUrl = _mode == MapPrivacyMode.OpenFreeMap
                ? Configuration["Maps:StyleUrl"] ?? "https://tiles.openfreemap.org/styles/liberty"
                : null,
            editable = Editable,
            label = Label,
            reportLoadStatus = ShowLoadStatus,
            describedBy = Editable ? $"{_id}-instructions" : null
        }, _reference);
        if (_disposed)
        {
            try { await JS.InvokeVoidAsync("activityExplorerMap.destroy", _id); }
            catch (JSDisconnectedException) { }
            return;
        }
        _initialized = true;
        _renderedLayers = layers;
        _renderedSections = sections;
        _renderedSectionId = sectionId;
        _renderedActivityTrack = activityTrack;
        _renderedActivitySelection = activitySelection;
        _renderedBaselineComparisonTrack = baselineComparisonTrack;
        _renderedComparisonTrack = comparisonTrack;
        _renderedHighlightPoints = highlightPoints;
        RememberSelection(selectionStart, selectionEnd, selectionReversed);
        if (HasPendingUpdates) await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task UpdateLayerStatus(bool loading, bool failed, int count, int revision) => InvokeAsync(() =>
    {
        if (_disposed || revision < _layerRevision) return;
        _layerRevision = revision;
        _layersFailed = failed;
        _layerStatus = _cellsView
            ? string.IsNullOrEmpty(ExplorationUrl) ? "" : loading ? "Loading map cells..." : failed
                ? "Map cells could not be loaded. Retry to refresh this view."
                : count == 0 ? "No cells in this view. Adjust the filters or zoom out." : ""
            : loading ? "Loading map lines..." : failed
                ? "Some map lines could not be loaded. Retry to refresh this view."
                : count == 0 ? "No lines in this view. Adjust the filters or zoom out." : "";
        StateHasChanged();
    });

    [JSInvokable]
    public Task SelectExplorationCell(int cellId) => cellId is >= 0 and < 268435456
        ? SelectedCellIdChanged.InvokeAsync(cellId) : Task.CompletedTask;

    [JSInvokable]
    public Task InvalidateExploration() => ExplorationInvalidated.InvokeAsync();

    [JSInvokable]
    public Task UpdateExplorationSummary(ExplorationSummary summary) => ExplorationSummaryChanged.InvokeAsync(summary);

    private async Task RetryLayersAsync() => await JS.InvokeVoidAsync("activityExplorerMap.reload", _id);

    [JSInvokable]
    public Task SelectSection(Guid sectionId) => Sections.Any(section => section.Id == sectionId)
        ? SelectedSectionIdChanged.InvokeAsync(sectionId) : Task.CompletedTask;

    [JSInvokable]
    public async Task UpdateDrawing(double[][] coordinates)
    {
        _pointStatus = coordinates.Length == 0
            ? "No points added."
            : $"{coordinates.Length} point{(coordinates.Length == 1 ? string.Empty : "s")} in the path. Latest point: latitude {coordinates[^1][1]:F5}, longitude {coordinates[^1][0]:F5}.";
        await PointsChanged.InvokeAsync(coordinates
            .Select(x => new TrackPoint(null, x[1], x[0], null, null, null, null, null, null, null))
            .ToArray());
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddCenterPointAsync() =>
        await JS.InvokeVoidAsync("activityExplorerMap.addCenterPoint", _id);

    public ValueTask UndoAsync() => JS.InvokeVoidAsync("activityExplorerMap.undo", _id);
    public ValueTask ClearAsync() => JS.InvokeVoidAsync("activityExplorerMap.clear", _id);

    private bool HasPendingUpdates => _renderedLayers != CurrentLayers || !ReferenceEquals(_renderedActivityTrack, ActivityTrack) ||
        !ReferenceEquals(_renderedActivitySelection, ActivitySelection) ||
        !ReferenceEquals(_renderedBaselineComparisonTrack, BaselineComparisonTrack) ||
        !ReferenceEquals(_renderedComparisonTrack, ComparisonTrack) ||
        !ReferenceEquals(_renderedHighlightPoints, HighlightPoints) ||
        !ReferenceEquals(_renderedSections, Sections) || _renderedSectionId != SelectedSectionId ||
        _renderedSelectionStart != SelectionStartIndex || _renderedSelectionEnd != SelectionEndIndex ||
        _renderedSelectionReversed != SelectionReversed;

    private static double[][]? Coordinates(IReadOnlyList<TrackPoint>? points) => points?
        .Where(point => point.Longitude.HasValue && point.Latitude.HasValue)
        .Select(point => new[] { point.Longitude!.Value, point.Latitude!.Value }).ToArray();

    private void RememberSelection(int? start, int? end, bool reversed)
    {
        _renderedSelectionStart = start;
        _renderedSelectionEnd = end;
        _renderedSelectionReversed = reversed;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_initialized)
        {
            try { await JS.InvokeVoidAsync("activityExplorerMap.destroy", _id); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
