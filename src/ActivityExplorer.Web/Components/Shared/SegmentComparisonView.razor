@implements IAsyncDisposable
@inject IJSRuntime JS

<section id="@_id" class="segment-comparison" aria-labelledby="@($"{_id}-heading")" data-comparison-view>
    <div class="panel comparison-result">
        <h2 id="@($"{_id}-heading")">Effort difference</h2>
        @if (Result.Baseline is not null && Result.Comparison is not null)
        {
            <p class="comparison-total"><strong>@Signed(Result.Comparison.ElapsedSeconds - Result.Baseline.ElapsedSeconds)</strong><span>@OverallDescription</span></p>
            <ul class="comparison-legend" aria-label="Effort line styles">
                <li><span class="baseline-key" aria-hidden="true"></span>Baseline · #@Result.Baseline.Rank · @Result.Baseline.StartTime.ToLocalTime().ToString("g") · @Format.Duration(Result.Baseline.ElapsedSeconds)</li>
                <li><span class="comparison-key" aria-hidden="true"></span>Comparison · #@Result.Comparison.Rank · @Result.Comparison.StartTime.ToLocalTime().ToString("g") · @Format.Duration(Result.Comparison.ElapsedSeconds)</li>
            </ul>
        }
        <p class="muted">Positive differences mean the comparison took longer. The distance follows the saved segment path.</p>
    </div>
    @if (!Available)
    {
        <div class="notice" role="status"><strong>Aligned comparison unavailable</strong><p>@(Result.Message ?? "Choose two distinct efforts with complete timing and GPS to compare along the path.")</p></div>
    }
    else
    {
        <div class="comparison-charts">
            @foreach (var chart in _charts)
            {
                <section class="chart-panel comparison-chart @(chart.Metric == 0 ? "comparison-gap" : null)" data-comparison-metric="@chart.Metric">
                    <div class="chart-heading"><h3>@chart.Title</h3><span>@chart.Unit</span></div>
                    @if (!chart.HasValues)
                    {
                        <p class="muted comparison-empty">@(chart.Metric == 1 && HasStoppedSpeed ? "Pace is undefined while stopped. Inspect recorded zero speed in the values table." : "Not recorded in either effort.")</p>
                    }
                    else
                    {
                        <div class="comparison-plot-layout">
                            <div class="comparison-y-axis" aria-hidden="true">
                                @foreach (var tick in chart.Scale.Ticks.Reverse())
                                {
                                    <span>@tick.Label</span>
                                }
                            </div>
                            <svg viewBox="0 0 800 180" preserveAspectRatio="none" class="comparison-plot" role="img" aria-label="@($"{chart.Title} by segment distance. Inspect values using the distance slider below.")">
                                @foreach (var tick in chart.Scale.Ticks)
                                {
                                    <line class="chart-gridline" x1="0" x2="800" y1="@Invariant(tick.Position)" y2="@Invariant(tick.Position)" />
                                }
                                @if (chart.Metric == 0)
                                {
                                    <line class="comparison-zero" x1="0" x2="800" y1="@Invariant(chart.Scale.Project(0, 180))" y2="@Invariant(chart.Scale.Project(0, 180))" />
                                }
                                @foreach (var line in chart.Baseline.Lines) { <polyline class="comparison-line baseline" points="@line" /> }
                                @foreach (var point in chart.Baseline.IsolatedPoints) { <circle class="comparison-dot baseline" cx="@Invariant(point.X)" cy="@Invariant(point.Y)" r="3" /> }
                                @foreach (var line in chart.Comparison.Lines) { <polyline class="comparison-line compared" points="@line" /> }
                                @foreach (var point in chart.Comparison.IsolatedPoints) { <circle class="comparison-dot compared" cx="@Invariant(point.X)" cy="@Invariant(point.Y)" r="3" /> }
                                <line class="comparison-cursor" x1="0" x2="0" y1="0" y2="180" visibility="hidden" />
                                <circle class="comparison-marker baseline" cx="0" cy="0" r="4" visibility="hidden" />
                                <circle class="comparison-marker compared" cx="0" cy="0" r="4" visibility="hidden" />
                            </svg>
                        </div>
                        <div class="comparison-x-axis" aria-hidden="true"><span>0 m</span><span>@Format.Distance(_distance / 2)</span><span>@Format.Distance(_distance)</span></div>
                    }
                    @if (chart.Metric == 0) { <p class="muted comparison-chart-note">Above zero: comparison slower. Below zero: comparison faster. Vertical changes include stationary time.</p> }
                </section>
            }
        </div>
        <section class="panel comparison-inspection" aria-labelledby="@($"{_id}-inspect")">
            <h3 id="@($"{_id}-inspect")">Inspect both efforts</h3>
            <p id="@($"{_id}-help")" class="muted">Point to or touch a chart, or use the slider and arrow keys. Values at a pause show departure time. Missing sensor readings appear as gaps.</p>
            <label for="@($"{_id}-slider")">Segment distance</label>
            <input id="@($"{_id}-slider")" class="comparison-inspector" type="range" min="0" max="@(_inspectionSamples.Count - 1)" value="0" step="1" aria-describedby="@($"{_id}-help")" />
            <output class="comparison-location" aria-live="polite">@Format.Distance(_inspectionSamples[0].DistanceMeters) · Time difference @Signed(_inspectionSamples[0].DeltaSeconds)</output>
            <div class="comparison-table-wrap"><table class="comparison-values">
                <caption>Values at the inspected distance</caption>
                <thead><tr><th scope="col">Measure</th><th scope="col">Baseline</th><th scope="col">Comparison</th></tr></thead>
                <tbody>
                    <tr><th scope="row">Elapsed time</th><td data-inspection-value="baseline-elapsed">@Elapsed(_inspectionSamples[0].Baseline.ElapsedSeconds)</td><td data-inspection-value="comparison-elapsed">@Elapsed(_inspectionSamples[0].Comparison.ElapsedSeconds)</td></tr>
                    <tr><th scope="row">@Format.SpeedLabel(Sport)</th><td data-inspection-value="baseline-speed">@Speed(_inspectionSamples[0].Baseline.SpeedMetersPerSecond)</td><td data-inspection-value="comparison-speed">@Speed(_inspectionSamples[0].Comparison.SpeedMetersPerSecond)</td></tr>
                    <tr><th scope="row">Heart rate</th><td data-inspection-value="baseline-heart">@Sensor(_inspectionSamples[0].Baseline.HeartRate, "bpm")</td><td data-inspection-value="comparison-heart">@Sensor(_inspectionSamples[0].Comparison.HeartRate, "bpm")</td></tr>
                    <tr><th scope="row">Power</th><td data-inspection-value="baseline-power">@Sensor(_inspectionSamples[0].Baseline.PowerWatts, "W")</td><td data-inspection-value="comparison-power">@Sensor(_inspectionSamples[0].Comparison.PowerWatts, "W")</td></tr>
                </tbody>
            </table></div>
        </section>
    }
    @if (Result.Children.Count > 0)
    {
        <section class="panel" aria-labelledby="@($"{_id}-children")">
            <h2 id="@($"{_id}-children")">Sub-segment differences</h2>
            <p class="muted">Only passes inside each selected parent effort are included. Overlapping or shared sections are independent; their differences need not add up to the overall result.</p>
            <div class="comparison-table-wrap"><table class="comparison-children">
                <thead><tr><th scope="col">Section / occurrence</th><th scope="col">Baseline</th><th scope="col">Comparison</th><th scope="col">Difference</th></tr></thead>
                <tbody>
                    @foreach (var child in Result.Children)
                    {
                        <tr data-comparison-child="@child.Child.Id" data-occurrence="@child.Occurrence">
                            <th scope="row"><a href="@($"/segments/{child.Child.Id}")">@child.Child.Name</a><small>Occurrence @child.Occurrence · @Format.Distance(child.Placement.StartDistanceMeters)–@Format.Distance(child.Placement.EndDistanceMeters)</small></th>
                            <td>@ChildEffort(child.Child.Id, child.Baseline, child.BaselineStatus)</td>
                            <td>@ChildEffort(child.Child.Id, child.Comparison, child.ComparisonStatus)</td>
                            <td>@(child.DeltaSeconds is double delta ? Signed(delta) : "Unavailable")</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>
    }
</section>

@code {
    [Parameter, EditorRequired] public SegmentComparisonResult Result { get; set; } = null!;
    [Parameter, EditorRequired] public string InspectionGroupId { get; set; } = "";
    private readonly string _id = $"comparison-{Guid.NewGuid():N}";
    private SegmentComparisonResult? _prepared;
    private SegmentComparisonResult? _bound;
    private string? _boundGroup;
    private IReadOnlyList<SegmentComparisonSample> _inspectionSamples = [];
    private IReadOnlyList<ComparisonChart> _charts = [];
    private double _distance;
    private bool _disposed;
    private SportKind Sport => Result.Detail.Summary.Sport;
    private bool HasStoppedSpeed => Result.Samples.Any(sample => sample.Baseline.SpeedMetersPerSecond == 0 || sample.Comparison.SpeedMetersPerSecond == 0);
    private bool Available => Result.UnavailableReason == SegmentComparisonUnavailableReason.None && _inspectionSamples.Count > 1;
    private string OverallDescription => Result.Comparison!.ElapsedSeconds.CompareTo(Result.Baseline!.ElapsedSeconds) switch
    {
        > 0 => "Comparison slower overall", < 0 => "Comparison faster overall", _ => "Same elapsed time"
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Result, _prepared)) return;
        _prepared = Result;
        _inspectionSamples = Result.Samples.Where(sample => !sample.IsArrival).ToArray();
        if (_inspectionSamples.Count == 0) { _charts = []; return; }
        _distance = Result.Samples[^1].DistanceMeters;
        var retained = SegmentComparisonGeometry.RetainedSamples(Result.Samples, Sport);
        _charts = Enumerable.Range(0, 4).Select(metric =>
        {
            var values = Result.Samples.SelectMany(sample => metric == 0
                ? new[] { (double?)sample.DeltaSeconds }
                : new[] { SegmentComparisonGeometry.Value(sample, metric, true, Sport), SegmentComparisonGeometry.Value(sample, metric, false, Sport) })
                .Where(value => value.HasValue && double.IsFinite(value.Value)).Select(value => value!.Value).ToArray();
            var scale = ChartScaleBuilder.Build(values.Length > 0 ? values.Min() : 0, values.Length > 0 ? values.Max() : 0, includeZero: metric == 0);
            var title = metric switch { 0 => "Time gap", 1 => Format.SpeedLabel(Sport), 2 => "Heart rate", _ => "Power" };
            var unit = metric switch { 0 => "seconds", 1 => Format.SpeedUnit(Sport), 2 => "bpm", _ => "W" };
            return new ComparisonChart(metric, title, unit, values.Length > 0, scale,
                SegmentComparisonGeometry.BuildSeries(Result.Samples, retained, metric, true, Sport, scale, _distance),
                metric == 0 ? new([], []) : SegmentComparisonGeometry.BuildSeries(Result.Samples, retained, metric, false, Sport, scale, _distance));
        }).ToArray();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || ReferenceEquals(_bound, Result) && _boundGroup == InspectionGroupId) return;
        var result = Result;
        var group = InspectionGroupId;
        if (Available)
            await JS.InvokeVoidAsync("segmentComparison.bind", _id, group, new
            {
                distance = _distance,
                sport = Sport.ToString(),
                samples = _inspectionSamples.Select(sample => new
                {
                    distanceMeters = sample.DistanceMeters, deltaSeconds = sample.DeltaSeconds,
                    baseline = new { sample.Baseline.ElapsedSeconds, sample.Baseline.SpeedMetersPerSecond, sample.Baseline.HeartRate, sample.Baseline.PowerWatts, sample.Baseline.Position },
                    comparison = new { sample.Comparison.ElapsedSeconds, sample.Comparison.SpeedMetersPerSecond, sample.Comparison.HeartRate, sample.Comparison.PowerWatts, sample.Comparison.Position }
                }),
                scales = _charts.Select(chart => new { metric = chart.Metric, minimum = chart.Scale.Minimum, maximum = chart.Scale.Maximum })
            });
        else await JS.InvokeVoidAsync("segmentComparison.unbind", _id);
        if (_disposed) { await JS.InvokeVoidAsync("segmentComparison.unbind", _id); return; }
        _bound = result;
        _boundGroup = group;
        if (!ReferenceEquals(Result, result) || InspectionGroupId != group) await InvokeAsync(StateHasChanged);
    }

    private static string Invariant(double value) => SegmentComparisonGeometry.Invariant(value);
    private static string Signed(double seconds) => $"{seconds:+0.###;−0.###;0} s";
    private static string Elapsed(double seconds) => $"{seconds:N3} s";
    private static string Sensor(double? value, string unit) => value.HasValue ? $"{value:N1} {unit}" : "Not recorded";
    private string Speed(double? speed) => speed == 0 ? Sport == SportKind.Cycling ? "0 km/h" : "Stopped (0 m/s)" : speed.HasValue ? Format.Speed(speed, Sport) : "Not recorded";
    private static RenderFragment ChildEffort(Guid childId, SegmentEffortSummary? effort, SegmentChildComparisonStatus status) => builder =>
    {
        if (status == SegmentChildComparisonStatus.Matched && effort is not null)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", $"/segments/{childId}?effort={effort.Id}");
            builder.AddContent(2, Format.Duration(effort.ElapsedSeconds));
            builder.CloseElement();
        }
        else builder.AddContent(3, status switch
        {
            SegmentChildComparisonStatus.Missing => "Missing",
            SegmentChildComparisonStatus.Ambiguous => "Ambiguous",
            _ => "Alignment unavailable"
        });
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await JS.InvokeVoidAsync("segmentComparison.unbind", _id); }
        catch (JSDisconnectedException) { }
    }

    private sealed record ComparisonChart(int Metric, string Title, string Unit, bool HasValues, ChartScaleGeometry Scale,
        ComparisonPlotSeries Baseline, ComparisonPlotSeries Comparison);
}
