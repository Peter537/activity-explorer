@inject IActivityOrganizationService Organization
@implements IDisposable

<section class="panel batch-editor" aria-label="Bulk activity editor" aria-busy="@_busy">
    <h2 @ref="_heading" tabindex="-1">@(_state is Applied ? "Activity changes applied" : _review is null ? "Edit activities" : "Review activity changes")</h2>
    <StatusMessage Message="@_error" IsError="true" />
    @if (_state is Applied applied)
    {
        <p>Reviewed @applied.Result.ReviewedCount.ToString("N0") activities; changed @applied.Result.ChangedCount.ToString("N0").</p>
        <button class="button" @onclick="OnCancel">Close editing</button>
    }
    else if (_review is null)
    {
        <p>@(AllMatching ? "Prepare an exact snapshot of the applied search." : $"Edit {SelectedIds.Count:N0} selected activities across pages.")</p>
        <div class="batch-fields">
            <TagPicker Tags="Tags" SelectedIds="_add" Changed="value => _add = value" Label="Add tags" Disabled="_busy" />
            <TagPicker Tags="Tags" SelectedIds="_remove" Changed="value => _remove = value" Label="Remove tags" Disabled="_busy" />
            <label><span id="batch-gear-label">Gear change</span><select aria-labelledby="batch-gear-label" @bind="_gearMode" disabled="@_busy"><option value="@GearEditMode.Unchanged">Leave unchanged</option><option value="@GearEditMode.Set">Set gear</option><option value="@GearEditMode.Clear">Clear gear</option></select></label>
            @if (_gearMode == GearEditMode.Set)
            {
                <label><span>Gear name</span><input @bind="_gear" maxlength="160" disabled="@_busy" /></label>
            }
        </div>
        <div class="button-row">
            <button class="button primary" disabled="@_busy" @onclick="Prepare">Review changes</button>
            <button class="button" disabled="@_busy" @onclick="OnCancel">Cancel editing</button>
        </div>
    }
    else
    {
        <p><strong>@_review.Members.Count.ToString("N0") activities</strong> in this exact snapshot. Activities imported after this review are excluded.</p>
        <ul>
            @if (_review.AddTags.Count > 0) { <li>Add tags: @string.Join(", ", _review.AddTags.Select(tag => tag.Name))</li> }
            @if (_review.RemoveTags.Count > 0) { <li>Remove tags: @string.Join(", ", _review.RemoveTags.Select(tag => tag.Name))</li> }
            @if (_review.Changes.GearMode == GearEditMode.Set) { <li>Set gear to: @_review.Changes.GearName</li> }
            @if (_review.Changes.GearMode == GearEditMode.Clear) { <li>Clear gear</li> }
        </ul>
        <div class="button-row">
            <button class="button primary" disabled="@(_state is not Reviewed)" @onclick="Apply">Apply changes</button>
            <button class="button" disabled="@(_busy || _state is Unconfirmed)" @onclick="ChangeEdits">Change edits</button>
            <button class="button" disabled="@_busy" @onclick="OnCancel">Cancel editing</button>
        </div>
    }
    @if (_error is not null) { <button class="button" disabled="@_busy" @onclick="OnRefresh">Refresh activities</button> }
</section>

@code {
    [Parameter] public Guid OwnerId { get; set; }
    [Parameter] public IReadOnlyList<Guid> SelectedIds { get; set; } = [];
    [Parameter] public bool AllMatching { get; set; }
    [Parameter] public ActivityFilter? Filter { get; set; }
    [Parameter] public IReadOnlyList<TagSummary> Tags { get; set; } = [];
    [Parameter] public EventCallback<BatchEditResult> OnApplied { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    private IReadOnlyList<Guid> _add = [], _remove = [];
    private GearEditMode _gearMode;
    private string _gear = "";
    private BatchState _state = new Editing();
    private bool _disposed;
    private bool _busy => _state is Preparing or Applying;
    private BatchReview? _review => _state switch
    {
        Reviewed value => value.Review, Applying value => value.Review, NeedsReview value => value.Review,
        Unconfirmed value => value.Review, _ => null
    };
    private string? _error => _state switch
    {
        Editing value => value.Error, NeedsReview value => value.Error, Unconfirmed value => value.Error,
        Applied value => value.RefreshError, _ => null
    };
    private ElementReference _heading;
    private bool _focusReview;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusReview) return;
        _focusReview = false;
        await _heading.FocusAsync();
    }

    private async Task Prepare()
    {
        if (_disposed || _state is not Editing) return;
        _state = new Preparing();
        try
        {
            var review = await Organization.PrepareBatchAsync(OwnerId, AllMatching ? null : SelectedIds.ToArray(),
                AllMatching ? Filter : null, new(_add, _remove, _gearMode, _gear));
            if (_disposed) return;
            _state = new Reviewed(review);
            _focusReview = true;
        }
        catch (Exception exception) { if (!_disposed) _state = new Editing(exception.Message); }
    }

    private async Task Apply()
    {
        if (_disposed || _state is not Reviewed reviewed) return;
        _state = new Applying(reviewed.Review);
        BatchEditResult result;
        try
        {
            result = await Organization.ApplyBatchAsync(reviewed.Review);
        }
        catch (Exception exception)
        {
            if (!_disposed) _state = exception is ArgumentException or InvalidOperationException
                ? new NeedsReview(reviewed.Review, $"Nothing changed. {exception.Message}")
                : new Unconfirmed(reviewed.Review, "The result could not be confirmed. Refresh activities before reviewing another change.");
            return;
        }
        if (_disposed) return;
        _state = new Applied(result);
        try { await OnApplied.InvokeAsync(result); }
        catch { if (!_disposed) _state = new Applied(result, "Changes were applied, but the activity view could not be refreshed. Refresh activities to see the result."); }
    }

    private void ChangeEdits() { if (!_disposed && !_busy && _state is not (Applied or Unconfirmed)) _state = new Editing(); }
    public void Dispose() { _disposed = true; GC.SuppressFinalize(this); }
    private abstract record BatchState;
    private sealed record Editing(string? Error = null) : BatchState;
    private sealed record Preparing : BatchState;
    private sealed record Reviewed(BatchReview Review) : BatchState;
    private sealed record Applying(BatchReview Review) : BatchState;
    private sealed record NeedsReview(BatchReview Review, string Error) : BatchState;
    private sealed record Unconfirmed(BatchReview Review, string Error) : BatchState;
    private sealed record Applied(BatchEditResult Result, string? RefreshError = null) : BatchState;
}
